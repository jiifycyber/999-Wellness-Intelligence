  Future<void> _sendProviderMessage() async {
    final user = Supabase.instance.client.auth.currentUser;
    final customer = _providerSelectedCustomer;

    if (user == null || customer == null || _providerMessageSending) {
      return;
    }

    final customerId = customer['id']?.toString() ?? '';
    final body = _providerMessageController.text.trim();

    if (customerId.isEmpty || body.isEmpty) {
      return;
    }

    setState(() {
      _providerMessageSending = true;
    });

    try {
      await Supabase.instance.client.from('messages').insert({
        'sender_id': user.id,
        'receiver_id': customerId,
        'message': body,
      });

      _providerMessageController.clear();

      await _loadProviderConversation(customer);
      await _loadProviderMessagingNetwork();
    } catch (_) {
      if (!mounted) {
        return;
      }

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          behavior: SnackBarBehavior.floating,
          content: Text('Message could not be sent.'),
        ),
      );
    } finally {
      if (mounted) {
        setState(() {
          _providerMessageSending = false;
        });
      }
    }
  }

  List<Map<String, dynamic>> get _visibleProviderConversations {
    final query = _providerMessageQuery.trim().toLowerCase();

    if (query.isEmpty) {
      return _providerConversations;
    }

    return _providerConversations.where((conversation) {
      final customer = conversation['customer'] as Map<String, dynamic>;

      final name = customer['name']?.toString().toLowerCase() ?? '';

      final body = conversation['last_message']?.toString().toLowerCase() ?? '';

      return name.contains(query) || body.contains(query);
    }).toList();
  }

  int get _providerUnreadMessageCount {
    return _providerConversations.fold<int>(
      0,
      (total, conversation) =>
          total + (conversation['unread_count'] as int? ?? 0),
    );
  }

