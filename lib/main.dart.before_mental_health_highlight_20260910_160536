}

class _CustomerBookingFlowScreenState
    extends State<_CustomerBookingFlowScreen> {
  String _service = '';
  String _day = 'Today';
  String _time = '4:30 PM';
  String _preferredContactMethod = 'Phone';
  bool _submitting = false;
  bool _servicesLoading = true;
  String? _servicesError;
  List<Map<String, dynamic>> _providerServices = [];

  final _customerNameController = TextEditingController();
  final _customerPhoneController = TextEditingController();
  final _customerEmailController = TextEditingController();
  final _serviceAddressController = TextEditingController();
  final _accessInstructionsController = TextEditingController();
  final _bookingNotesController = TextEditingController();

  @override
  void initState() {
    super.initState();
    _loadCustomerContact();
    _loadProviderServices();
  }

  Future<void> _loadProviderServices() async {
    try {
      String? resolvedProviderId = widget.providerId;

      if (resolvedProviderId == null || resolvedProviderId.trim().isEmpty) {
        final providerRecord = await Supabase.instance.client
            .from('provider_profiles')
            .select('id')
            .eq('professional_name', widget.providerName)
            .maybeSingle();

        resolvedProviderId = providerRecord?['id']?.toString();
      }

      if (resolvedProviderId == null || resolvedProviderId.trim().isEmpty) {
        throw Exception('Provider ID could not be resolved.');
      }

      final data = await Supabase.instance.client
          .from('provider_services')
          .select('provider_id, service_name, specialty, price, active')
          .eq('provider_id', resolvedProviderId)
          .eq('active', true)
          .order('service_name');

      final rows = (data as List)
          .map((row) => Map<String, dynamic>.from(row as Map))
          .where((row) {
            final name = row['service_name']?.toString().trim() ?? '';
            final price = double.tryParse(row['price']?.toString() ?? '');
            return name.isNotEmpty && price != null && price > 0;
          })
          .toList();

      if (!mounted) return;

      setState(() {
        _providerServices = rows;
        _service = rows.isNotEmpty
            ? rows.first['service_name']?.toString() ?? ''
            : '';
        _servicesLoading = false;
        _servicesError = null;
      });
    } catch (error) {
      if (!mounted) return;

      setState(() {
        _providerServices = [];
        _service = '';
        _servicesLoading = false;
        _servicesError = error.toString();
      });
    }
  }

  Map<String, dynamic>? get _selectedServiceRecord {
    for (final service in _providerServices) {
      if (service['service_name']?.toString() == _service) {
        return service;
      }
    }
    return null;
  }

  double? get _selectedServicePrice {
    final value = _selectedServiceRecord?['price'];
    return double.tryParse(value?.toString() ?? '');
  }

  Future<void> _loadCustomerContact() async {
    final user = Supabase.instance.client.auth.currentUser;
    if (user == null) return;

    try {
      final profile = await Supabase.instance.client
          .from('profiles')
          .select('full_name, email, phone')
          .eq('id', user.id)
          .maybeSingle();

      _customerNameController.text =
          profile?['full_name']?.toString() ??
          user.userMetadata?['full_name']?.toString() ??
          '';

      _customerPhoneController.text =
          profile?['phone']?.toString() ??
          user.userMetadata?['phone']?.toString() ??
          '';

      _customerEmailController.text =
          profile?['email']?.toString() ?? user.email ?? '';
    } catch (_) {
      _customerNameController.text =
          user.userMetadata?['full_name']?.toString() ?? '';
      _customerPhoneController.text =
          user.userMetadata?['phone']?.toString() ?? '';
      _customerEmailController.text = user.email ?? '';
    }

    if (mounted) {
      setState(() {});
    }
  }

  @override
  void dispose() {
    _customerNameController.dispose();
    _customerPhoneController.dispose();
    _customerEmailController.dispose();
    _serviceAddressController.dispose();
    _accessInstructionsController.dispose();
    _bookingNotesController.dispose();
    super.dispose();
  }

  Future<void> _submitBooking() async {
    if (_submitting) return;

    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Please sign in before creating a booking.'),
        ),
      );
      return;
    }

    final customerName = _customerNameController.text.trim();
    final customerPhone = _customerPhoneController.text.trim();
    final customerEmail = _customerEmailController.text.trim();
    final serviceAddress = _serviceAddressController.text.trim();
    final accessInstructions = _accessInstructionsController.text.trim();
    final bookingNotes = _bookingNotesController.text.trim();

    if (customerName.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Please enter your full name.')),
      );
      return;
    }

    if (customerPhone.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Please enter your phone number.')),
      );
      return;
    }

    if (customerEmail.isEmpty ||
        !customerEmail.contains('@') ||
        !customerEmail.contains('.')) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Please enter a valid email address.')),
      );
      return;
    }

    if (serviceAddress.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Please enter the service address.')),
      );
      return;
    }

    setState(() {
      _submitting = true;
    });

    try {
      String? providerId = widget.providerId;

      if (providerId == null || providerId.trim().isEmpty) {
        final providerRecord = await Supabase.instance.client
            .from('provider_profiles')
            .select('id')
            .eq('professional_name', widget.providerName)
            .maybeSingle();

        providerId = providerRecord?['id']?.toString();
      }

      final selectedPrice = _selectedServicePrice;

      if (providerId == null || providerId.trim().isEmpty) {
        throw Exception('Provider ID missing.');
      }

      if (_service.trim().isEmpty || selectedPrice == null) {
        throw Exception('Please select a valid provider service.');
      }

      final bookingRecord = await Supabase.instance.client
          .from('bookings')
          .insert({
            'customer_id': user.id,
            'provider_id': providerId,
            'provider_name': widget.providerName,
            'service_name': _service,
            'price': selectedPrice,
            'booking_day': _day,
            'booking_time': _time,
            'service_type': 'Mobile Service',
            'service_address': serviceAddress,
            'customer_name': customerName,
            'customer_phone': customerPhone,
            'customer_email': customerEmail,
            'preferred_contact_method': _preferredContactMethod,
            'access_instructions': accessInstructions.isEmpty
                ? null
                : accessInstructions,
            'booking_notes': bookingNotes.isEmpty ? null : bookingNotes,
            'status': 'Requested',
            'payment_status': 'Pending',
          })
          .select('id')
          .single();

      final bookingId = bookingRecord['id']?.toString().trim() ?? '';

      if (bookingId.isEmpty) {
        throw Exception('Booking was created without an ID.');
      }

      final checkoutResponse = await Supabase.instance.client.functions.invoke(
        'create-checkout-session',
        body: {'booking_id': bookingId},
      );

      final rawCheckoutData = checkoutResponse.data;

      final checkoutData = rawCheckoutData is Map
          ? Map<String, dynamic>.from(rawCheckoutData)
          : <String, dynamic>{};

      final checkoutUrl = checkoutData['checkout_url']?.toString().trim() ?? '';

      if (checkoutUrl.isEmpty) {
        final checkoutError = checkoutData['error']?.toString().trim() ?? '';

        throw Exception(
          checkoutError.isNotEmpty
              ? checkoutError
              : 'Stripe checkout URL was not returned.',
        );
      }

      final checkoutUri = Uri.tryParse(checkoutUrl);

      if (checkoutUri == null ||
          (checkoutUri.scheme != 'https' && checkoutUri.scheme != 'http')) {
        throw Exception('Stripe returned an invalid checkout URL.');
      }

      final opened = await launchUrl(
        checkoutUri,
        mode: LaunchMode.externalApplication,
      );

      if (!opened) {
        throw Exception('Secure Stripe Checkout could not be opened.');
      }

      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text(
            'Secure checkout opened. Complete payment to finish your booking.',
          ),
        ),
      );

      Navigator.of(context).pushReplacement(
        MaterialPageRoute(builder: (_) => const _CustomerBookingsScreen()),
      );
    } catch (error) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Unable to create booking: $error')),
      );
    } finally {
      if (mounted) {
        setState(() {
          _submitting = false;
        });
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    return _CustomerPageShell(
      title: 'Book ${widget.providerName}',
      child: SingleChildScrollView(
        padding: const EdgeInsets.all(18),
        child: Center(
          child: ConstrainedBox(
            constraints: const BoxConstraints(maxWidth: 760),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                const _BookingSectionTitle(
                  number: '01',
                  title: 'Choose Service',
                ),
                const SizedBox(height: 10),
                if (_servicesLoading)
                  const Padding(
                    padding: EdgeInsets.symmetric(vertical: 14),
                    child: Center(child: CircularProgressIndicator()),
                  )
                else if (_servicesError != null)
                  const Text(
                    'Unable to load this provider’s services.',
                    style: TextStyle(color: Colors.white60),
                  )
                else if (_providerServices.isEmpty)
                  const Text(
                    'This provider has no active priced services available.',
                    style: TextStyle(color: Colors.white60),
                  )
                else
                  Wrap(
                    spacing: 8,
                    runSpacing: 8,
                    children: [
                      for (final option in _providerServices)
                        ChoiceChip(
                          label: Text(
                            '${option['service_name']} • '
                            '\$${double.tryParse(option['price']?.toString() ?? '')?.toStringAsFixed(2) ?? '0.00'}',
                          ),
                          selected:
                              _service == option['service_name']?.toString(),
                          onSelected: (_) {
                            setState(() {
                              _service =
                                  option['service_name']?.toString() ?? '';
                            });
                          },
                        ),
                    ],
                  ),

                const SizedBox(height: 25),

                const _BookingSectionTitle(number: '02', title: 'Choose Day'),
                const SizedBox(height: 10),

                Wrap(
                  spacing: 8,
                  children: [
