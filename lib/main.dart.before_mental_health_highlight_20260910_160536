  String _providerCustomerInitials(String name) {
    final parts = name
        .trim()
        .split(RegExp(r'\s+'))
        .where((part) => part.isNotEmpty)
        .toList();

    if (parts.isEmpty) {
      return 'CU';
    }

    if (parts.length == 1) {
      final word = parts.first.toUpperCase();
      return word.length > 1 ? word.substring(0, 2) : word;
    }

    return '${parts.first[0]}${parts.last[0]}'.toUpperCase();
  }

  String _providerMessageShortTime(dynamic value) {
    final date = DateTime.tryParse(value?.toString() ?? '')?.toLocal();

    if (date == null) {
      return '';
    }

    final hour = date.hour == 0
        ? 12
        : date.hour > 12
        ? date.hour - 12
        : date.hour;

    final minute = date.minute.toString().padLeft(2, '0');
    final suffix = date.hour >= 12 ? 'PM' : 'AM';

    return '$hour:$minute $suffix';
  }

  Future<void> _loadProviderMessagingNetwork() async {
    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) {
      if (!mounted) {
        return;
      }

      setState(() {
        _providerMessagesLoading = false;
        _providerMessagesError = 'Please sign in to use messaging.';
      });

      return;
    }

    if (mounted) {
      setState(() {
        _providerMessagesLoading = true;
        _providerMessagesError = null;
      });
    }

    try {
      final sentData = await Supabase.instance.client
          .from('messages')
          .select(
            'id, sender_id, receiver_id, message, read_at, created_at, '
            'attachment_path, attachment_name, attachment_type',
          )
          .eq('sender_id', user.id);

      final receivedData = await Supabase.instance.client
          .from('messages')
          .select(
            'id, sender_id, receiver_id, message, read_at, created_at, '
            'attachment_path, attachment_name, attachment_type',
          )
          .eq('receiver_id', user.id);

      final messages = <Map<String, dynamic>>[];

      for (final row in sentData as List) {
        messages.add(Map<String, dynamic>.from(row as Map));
      }

      for (final row in receivedData as List) {
        messages.add(Map<String, dynamic>.from(row as Map));
      }

      final seenIds = <String>{};

      messages.removeWhere((row) {
        final id = row['id']?.toString() ?? '';

        if (id.isEmpty) {
          return false;
        }

        if (seenIds.contains(id)) {
          return true;
        }

        seenIds.add(id);
        return false;
      });

      messages.sort((a, b) {
        final left = a['created_at']?.toString() ?? '';
        final right = b['created_at']?.toString() ?? '';
        return right.compareTo(left);
      });

      final customerIds = <String>{};

      for (final message in messages) {
        final sender = message['sender_id']?.toString() ?? '';
        final receiver = message['receiver_id']?.toString() ?? '';

        final otherId = sender == user.id ? receiver : sender;

        if (otherId.isNotEmpty && otherId != user.id) {
          customerIds.add(otherId);
        }
      }

      final customerById = <String, Map<String, dynamic>>{};

      try {
        final socialRows = await Supabase.instance.client
            .from('community_member_profiles')
            .select('user_id, display_name, role, photo_url, photo_path');

        for (final raw in socialRows as List) {
          final row = Map<String, dynamic>.from(raw as Map);
          final id = row['user_id']?.toString() ?? '';

          if (!customerIds.contains(id)) {
            continue;
          }

          String photo = row['photo_url']?.toString().trim() ?? '';
          final photoPath = row['photo_path']?.toString().trim() ?? '';

          if (photoPath.isNotEmpty) {
            try {
              photo = await Supabase.instance.client.storage
                  .from('community-profile-media')
                  .createSignedUrl(photoPath, 3600);
            } catch (_) {}
          }

          final name = row['display_name']?.toString().trim() ?? '';

          customerById[id] = <String, dynamic>{
            'id': id,
            'name': name.isNotEmpty ? name : 'Customer',
            'initials': _providerCustomerInitials(
              name.isNotEmpty ? name : 'Customer',
            ),
            'photo_url': photo,
            'role': row['role']?.toString() ?? 'customer',
          };
        }
      } catch (_) {}

      try {
        final profileRows = await Supabase.instance.client
            .from('profiles')
            .select('id, full_name');

        for (final raw in profileRows as List) {
          final row = Map<String, dynamic>.from(raw as Map);
          final id = row['id']?.toString() ?? '';

          if (!customerIds.contains(id)) {
            continue;
          }

          final fullName = row['full_name']?.toString().trim() ?? '';

          if (customerById.containsKey(id)) {
            final existing = customerById[id]!;

            if ((existing['name']?.toString() ?? '') == 'Customer' &&
                fullName.isNotEmpty) {
              existing['name'] = fullName;
              existing['initials'] = _providerCustomerInitials(fullName);
            }
          } else {
            final name = fullName.isNotEmpty ? fullName : 'Customer';

            customerById[id] = <String, dynamic>{
              'id': id,
              'name': name,
              'initials': _providerCustomerInitials(name),
              'photo_url': '',
              'role': 'customer',
            };
          }
        }
      } catch (_) {}

      for (final id in customerIds) {
        customerById.putIfAbsent(
          id,
          () => <String, dynamic>{
            'id': id,
            'name': 'Customer',
            'initials': 'CU',
            'photo_url': '',
            'role': 'customer',
          },
        );
      }

      final conversationByCustomer = <String, Map<String, dynamic>>{};

      for (final message in messages) {
        final sender = message['sender_id']?.toString() ?? '';
        final receiver = message['receiver_id']?.toString() ?? '';

        final customerId = sender == user.id ? receiver : sender;

        final customer = customerById[customerId];

        if (customer == null) {
          continue;
        }

        final unread =
            sender == customerId &&
            receiver == user.id &&
            message['read_at'] == null;

        final current = conversationByCustomer[customerId];

        if (current == null) {
          conversationByCustomer[customerId] = <String, dynamic>{
            'customer': customer,
            'last_message': message['message']?.toString() ?? '',
            'created_at': message['created_at']?.toString() ?? '',
            'unread_count': unread ? 1 : 0,
          };
        } else if (unread) {
          current['unread_count'] = (current['unread_count'] as int? ?? 0) + 1;
        }
      }

      final conversations = conversationByCustomer.values.toList();

      conversations.sort((a, b) {
        return b['created_at'].toString().compareTo(a['created_at'].toString());
      });

      final orderedCustomers = <Map<String, dynamic>>[];

      for (final conversation in conversations) {
        orderedCustomers.add(
          Map<String, dynamic>.from(conversation['customer'] as Map),
        );
      }

      Map<String, dynamic>? selected = _providerSelectedCustomer;

      if (selected != null) {
        final selectedId = selected['id']?.toString() ?? '';

        selected = null;

        for (final customer in orderedCustomers) {
          if (customer['id']?.toString() == selectedId) {
            selected = customer;
            break;
          }
        }
      }

      if (!mounted) {
        return;
      }

      setState(() {
        _providerMessageCustomers = orderedCustomers;
        _providerConversations = conversations;
        _providerSelectedCustomer = selected;
        _providerMessagesLoading = false;
        _providerMessagesError = null;
      });
    } catch (error) {
      if (!mounted) {
        return;
      }

      setState(() {
        _providerMessagesLoading = false;
        _providerMessagesError = 'Unable to load customer conversations.';
      });
    }
  }

  Future<void> _selectProviderMessageCustomer(
    Map<String, dynamic> customer,
  ) async {
    setState(() {
      _providerSelectedCustomer = customer;
      _providerChatLoading = true;
      _providerActiveMessages = [];
    });

