  Widget _generic() {
    IconData icon = Icons.apps_rounded;

    if (widget.title == 'Notifications') {
      icon = Icons.notifications_none_rounded;
    }

    if (widget.title == 'Provider Account') {
      icon = Icons.account_circle_outlined;
    }

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        _V2SectionLabel(
          title: widget.title.toUpperCase(),
          subtitle: 'PROVIDER INTELLIGENCE MODULE',
          icon: icon,
        ),
        const SizedBox(height: 12),

        _moduleAction(
          icon: icon,
          title: widget.title,
          subtitle: 'This provider module is connected and ready for its live backend data.',
          accent: const Color(0xFF8A55FF),
        ),
      ],
    );
  }

  Widget _content() {
    switch (widget.title) {
      case 'Bookings':
        return _bookings();

      case 'Schedule & Availability':
        return _schedule();

      case 'Provider Profile':
        return _profile();

      case 'Photos & Videos':
        return _media();

      case 'Earnings':
        return _earnings();

      case 'Agent Duke AI':
        return _ai();

      case 'Messages':
        return _messages();

      case 'Provider Settings':
        return _settings();

      case 'Notifications':
        return _providerNotifications();

      case 'Provider Account':
        return _providerAccount();

      default:
        return _generic();
    }
  }

