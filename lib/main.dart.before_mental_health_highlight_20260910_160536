class _CustomerAccountScreen extends StatefulWidget {
  const _CustomerAccountScreen();

  @override
  State<_CustomerAccountScreen> createState() => _CustomerAccountScreenState();
}

class _CustomerAccountScreenState extends State<_CustomerAccountScreen> {
  int _profileTab = 0;
  bool _profileBusy = false;

  Future<Map<String, dynamic>> _getProfile() async {
    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) {
      return <String, dynamic>{};
    }

    Map<String, dynamic> account = <String, dynamic>{};
    Map<String, dynamic> social = <String, dynamic>{};

    try {
      final row = await Supabase.instance.client
          .from('profiles')
          .select('full_name, email, phone, role, status')
          .eq('id', user.id)
          .maybeSingle();

      if (row != null) {
        account = Map<String, dynamic>.from(row);
      }
    } catch (_) {}

    try {
      final row = await Supabase.instance.client
          .from('community_member_profiles')
          .select(
            'user_id, display_name, role, photo_url, photo_path, '
            'cover_url, cover_path, bio, created_at, updated_at',
          )
          .eq('user_id', user.id)
          .maybeSingle();

      if (row != null) {
        social = Map<String, dynamic>.from(row);
      }
    } catch (_) {}

    String photoUrl = social['photo_url']?.toString().trim() ?? '';
    String coverUrl = social['cover_url']?.toString().trim() ?? '';

    final photoPath = social['photo_path']?.toString().trim() ?? '';
    final coverPath = social['cover_path']?.toString().trim() ?? '';

    if (photoPath.isNotEmpty) {
      try {
        photoUrl = await Supabase.instance.client.storage
            .from('community-profile-media')
            .createSignedUrl(photoPath, 3600);
      } catch (_) {}
    }

    if (coverPath.isNotEmpty) {
      try {
        coverUrl = await Supabase.instance.client.storage
            .from('community-profile-media')
            .createSignedUrl(coverPath, 3600);
      } catch (_) {}
    }

    final postRows = await Supabase.instance.client
        .from('community_posts')
        .select(
          'id, author_id, author_name, author_role, author_photo_url, '
          'body, media_path, media_type, created_at',
        )
        .eq('author_id', user.id)
        .order('created_at', ascending: false);

    final posts = (postRows as List)
        .map((row) => Map<String, dynamic>.from(row as Map))
        .toList();

    for (final post in posts) {
      final mediaPath = post['media_path']?.toString().trim() ?? '';

      post['_media_url'] = '';

      if (mediaPath.isEmpty) {
        continue;
      }

      try {
        post['_media_url'] = await Supabase.instance.client.storage
            .from('feed-media')
            .createSignedUrl(mediaPath, 3600);
      } catch (_) {}
    }

    int followers = 0;
    int following = 0;

    try {
      final rows = await Supabase.instance.client
          .from('community_follows')
          .select('follower_id')
          .eq('following_id', user.id);

      followers = (rows as List).length;
    } catch (_) {}

    try {
      final rows = await Supabase.instance.client
          .from('community_follows')
          .select('following_id')
          .eq('follower_id', user.id);

      following = (rows as List).length;
    } catch (_) {}

    return <String, dynamic>{
      'account': account,
      'social': social,
      'photo_url': photoUrl,
      'cover_url': coverUrl,
      'posts': posts,
      'followers': followers,
      'following': following,
      'email': user.email ?? '',
      'metadata_name': user.userMetadata?['full_name']?.toString() ?? '',
    };
  }

  String _safeFileName(String value) {
    final safe = value.replaceAll(RegExp(r'[^A-Za-z0-9._-]'), '_');

    return safe.isEmpty ? 'image.jpg' : safe;
  }

  Future<void> _changeProfileImage(String kind) async {
    final user = Supabase.instance.client.auth.currentUser;

    if (user == null || _profileBusy) {
      return;
    }

    final files = await FilePicker.pickFiles(
      type: FileType.custom,
      allowedExtensions: const ['jpg', 'jpeg', 'png', 'webp', 'heic', 'heif'],
    );

    if (files.isEmpty) {
      return;
    }

    final file = files.first;

    setState(() {
      _profileBusy = true;
    });

    try {
      final bytes = await file.readAsBytes();

      if (bytes.length > 10485760) {
        throw Exception('Image must be 10 MB or smaller.');
      }

      final account = await Supabase.instance.client
          .from('profiles')
          .select('full_name')
          .eq('id', user.id)
          .maybeSingle();

      final social = await Supabase.instance.client
          .from('community_member_profiles')
          .select('display_name, bio')
          .eq('user_id', user.id)
          .maybeSingle();

      final accountName = account?['full_name']?.toString().trim() ?? '';

      final socialName = social?['display_name']?.toString().trim() ?? '';

      final displayName = socialName.isNotEmpty
          ? socialName
          : accountName.isNotEmpty
          ? accountName
          : '999 Member';

      final stamp = DateTime.now().microsecondsSinceEpoch;

      final folder = kind == 'cover' ? 'cover' : 'profile';

      final storagePath =
          '${user.id}/$folder/${stamp}_${_safeFileName(file.name)}';

      await Supabase.instance.client.storage
          .from('community-profile-media')
          .uploadBinary(
            storagePath,
            bytes,
            fileOptions: const FileOptions(upsert: false),
          );

      final signedUrl = await Supabase.instance.client.storage
          .from('community-profile-media')
          .createSignedUrl(storagePath, 3600);

      final payload = <String, dynamic>{
        'user_id': user.id,
        'display_name': displayName,
        'role': 'customer',
        'bio': social?['bio']?.toString() ?? '',
        'updated_at': DateTime.now().toIso8601String(),
      };

      if (kind == 'cover') {
        payload['cover_path'] = storagePath;
        payload['cover_url'] = signedUrl;
      } else {
        payload['photo_path'] = storagePath;
        payload['photo_url'] = signedUrl;
      }

      await Supabase.instance.client
          .from('community_member_profiles')
          .upsert(payload);

      if (kind == 'profile') {
        await Supabase.instance.client
            .from('community_posts')
            .update({'author_photo_url': signedUrl})
            .eq('author_id', user.id);
      }

      if (!mounted) {
        return;
      }

      setState(() {});

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            kind == 'cover' ? 'Cover photo updated.' : 'Profile photo updated.',
          ),
        ),
      );
    } catch (error) {
      if (!mounted) {
        return;
      }

      ScaffoldMessenger.of(
        context,
      ).showSnackBar(SnackBar(content: Text('Unable to update image: $error')));
    } finally {
      if (mounted) {
        setState(() {
          _profileBusy = false;
        });
      }
    }
  }

  Future<void> _saveProfileText(String displayName, String bio) async {
    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) {
      return;
    }

    final cleanedName = displayName.trim();

    if (cleanedName.isEmpty) {
      ScaffoldMessenger.of(context)
          .showSnackBar(const SnackBar(content: Text('Enter a display name.')));
      return;
    }

    setState(() {
      _profileBusy = true;
    });

    try {
      await Supabase.instance.client.from('community_member_profiles').upsert({
        'user_id': user.id,
        'display_name': cleanedName,
        'role': 'customer',
        'bio': bio.trim(),
        'updated_at': DateTime.now().toIso8601String(),
      });

      await Supabase.instance.client
          .from('community_posts')
          .update({'author_name': cleanedName})
          .eq('author_id', user.id);

      if (!mounted) {
        return;
      }

      setState(() {});

      ScaffoldMessenger.of(context)
          .showSnackBar(const SnackBar(content: Text('Profile updated.')));
    } catch (error) {
      if (!mounted) {
        return;
      }

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Unable to update profile: $error')),
      );
    } finally {
      if (mounted) {
        setState(() {
          _profileBusy = false;
        });
      }
    }
  }

  Future<void> _openProfileEditor(String currentName, String currentBio) async {
    final nameController = TextEditingController(text: currentName);

    final bioController = TextEditingController(text: currentBio);

    await showDialog<void>(
      context: context,
      builder: (dialogContext) {
        return Dialog(
