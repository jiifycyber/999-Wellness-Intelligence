class _ProviderMediaGallery extends StatefulWidget {
  const _ProviderMediaGallery({required this.providerName});

  final String providerName;

  @override
  State<_ProviderMediaGallery> createState() => _ProviderMediaGalleryState();
}

class _ProviderMediaGalleryState extends State<_ProviderMediaGallery> {
  int _tab = 0;

  bool _loading = true;
  String? _error;
  String _providerId = '';

  List<Map<String, dynamic>> _livePhotos = [];
  List<Map<String, dynamic>> _liveVideos = [];

  // Kept empty only for compatibility with the old all-media screen.
  // No demo media is shown anymore.
  static const List<_ProviderMediaItem> _photos = [];
  static const List<_ProviderMediaItem> _videos = [];

  @override
  void initState() {
    super.initState();
    _loadLiveProviderMedia();
  }

  Future<void> _loadLiveProviderMedia() async {
    if (mounted) {
      setState(() {
        _loading = true;
        _error = null;
      });
    }

    try {
      final profileData = await Supabase.instance.client
          .from('provider_profiles')
          .select('id, full_name, professional_name');

      final profiles = (profileData as List)
          .map((row) => Map<String, dynamic>.from(row as Map))
          .toList();

      Map<String, dynamic>? matchedProfile;

      final target = widget.providerName.trim().toLowerCase();

      for (final profile in profiles) {
        final professionalName =
            profile['professional_name']?.toString().trim().toLowerCase() ?? '';

        final fullName =
            profile['full_name']?.toString().trim().toLowerCase() ?? '';

        if (professionalName == target || fullName == target) {
          matchedProfile = profile;
          break;
        }
      }

      if (matchedProfile == null) {
        throw Exception(
          'Provider profile not found for ${widget.providerName}.',
        );
      }

      final providerId = matchedProfile['id']?.toString() ?? '';

      if (providerId.isEmpty) {
        throw Exception('Provider ID is missing.');
      }

      final mediaData = await Supabase.instance.client
          .from('provider_media')
          .select(
            'id, provider_id, media_type, public_url, file_name, created_at',
          )
          .eq('provider_id', providerId)
          .order('created_at', ascending: false);

      final rows = (mediaData as List)
          .map((row) => Map<String, dynamic>.from(row as Map))
          .where(
            (row) => (row['public_url']?.toString().trim().isNotEmpty ?? false),
          )
          .toList();

      if (!mounted) return;

      setState(() {
        _providerId = providerId;

        _livePhotos = rows
            .where((row) => row['media_type']?.toString() == 'photo')
            .toList();

        _liveVideos = rows
            .where((row) => row['media_type']?.toString() == 'video')
            .toList();

        _loading = false;
        _error = null;
      });
    } catch (error) {
      if (!mounted) return;

      setState(() {
        _loading = false;
        _error = error.toString();
      });
    }
  }

  List<Map<String, dynamic>> get _currentItems {
    return _tab == 0 ? _livePhotos : _liveVideos;
  }

  void _openPhoto(Map<String, dynamic> selectedMedia) {
    final urls = _livePhotos
        .map((media) => media['public_url']?.toString() ?? '')
        .where((url) => url.isNotEmpty)
        .toList();

    final selectedUrl = selectedMedia['public_url']?.toString() ?? '';

    if (urls.isEmpty || selectedUrl.isEmpty) {
      return;
    }

    final index = urls.indexOf(selectedUrl);

    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (_) => _ProviderPhotoViewer(
          urls: urls,
          initialIndex: index < 0 ? 0 : index,
        ),
      ),
    );
  }

  void _openVideo(Map<String, dynamic> media) {
    final url = media['public_url']?.toString() ?? '';

    if (url.isEmpty) {
      return;
    }

    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (_) => _ProviderVideoViewer(
          url: url,
          title: media['file_name']?.toString() ?? 'Provider Video',
        ),
      ),
    );
  }

  Widget _emptyState() {
    final photos = _tab == 0;

    return Container(
      width: double.infinity,
      padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 42),
      decoration: BoxDecoration(
        color: Colors.white.withValues(alpha: 0.025),
        borderRadius: BorderRadius.circular(22),
        border: Border.all(color: Colors.white.withValues(alpha: 0.05)),
      ),
      child: Column(
        children: [
          Icon(
            photos
                ? Icons.photo_library_outlined
                : Icons.video_library_outlined,
            color: Colors.white30,
            size: 42,
          ),
          const SizedBox(height: 12),
          Text(
            photos
                ? 'No photos uploaded by this provider yet.'
                : 'No videos uploaded by this provider yet.',
            textAlign: TextAlign.center,
            style: const TextStyle(
              color: Colors.white54,
              fontWeight: FontWeight.w700,
            ),
          ),
        ],
      ),
    );
  }

  Widget _photoGallery() {
    return LayoutBuilder(
      builder: (context, constraints) {
        final columns = constraints.maxWidth > 720
            ? 3
            : constraints.maxWidth > 420
            ? 2
            : 1;

        const gap = 10.0;

        final width = (constraints.maxWidth - ((columns - 1) * gap)) / columns;

        return Wrap(
          spacing: gap,
          runSpacing: gap,
          children: [
            for (final media in _livePhotos)
              SizedBox(
                width: width,
                child: Material(
                  color: Colors.transparent,
                  child: InkWell(
                    onTap: () => _openPhoto(media),
                    borderRadius: BorderRadius.circular(17),
