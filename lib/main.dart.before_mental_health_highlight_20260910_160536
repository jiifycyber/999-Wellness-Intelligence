  Widget _profile() {
    Future<Map<String, dynamic>> loadProviderProfile() async {
      final user = Supabase.instance.client.auth.currentUser;

      if (user == null) {
        return <String, dynamic>{};
      }

      final profile = await Supabase.instance.client
          .from('provider_profiles')
          .select(
            'id, full_name, professional_name, business_name, bio, '
            'service_area, available_now, profile_photo_url, rating, review_count',
          )
          .eq('id', user.id)
          .maybeSingle();

      final servicesRaw = await Supabase.instance.client
          .from('provider_services')
          .select('service_name, specialty, price, active')
          .eq('provider_id', user.id)
          .eq('active', true);

      final mediaRaw = await Supabase.instance.client
          .from('provider_media')
          .select('id, media_type, public_url, file_name, created_at')
          .eq('provider_id', user.id)
          .order('created_at', ascending: false)
          .limit(12);

      return <String, dynamic>{
        'profile': profile == null
            ? <String, dynamic>{}
            : Map<String, dynamic>.from(profile),
        'services': (servicesRaw as List)
            .map((row) => Map<String, dynamic>.from(row as Map))
            .toList(),
        'media': (mediaRaw as List)
            .map((row) => Map<String, dynamic>.from(row as Map))
            .toList(),
      };
    }

    return FutureBuilder<Map<String, dynamic>>(
      future: loadProviderProfile(),
      builder: (context, snapshot) {
        if (snapshot.connectionState == ConnectionState.waiting) {
          return const Center(
            child: Padding(
              padding: EdgeInsets.all(70),
              child: CircularProgressIndicator(),
            ),
          );
        }

        if (snapshot.hasError) {
          return _moduleAction(
            icon: Icons.error_outline_rounded,
            title: 'Unable to load profile',
            subtitle: snapshot.error.toString(),
            accent: const Color(0xFFFF738D),
          );
        }

        final data = snapshot.data ?? <String, dynamic>{};

        final profile = Map<String, dynamic>.from(
          data['profile'] as Map? ?? const {},
        );

        final services = (data['services'] as List? ?? const [])
            .map((row) => Map<String, dynamic>.from(row as Map))
            .toList();

        final media = (data['media'] as List? ?? const [])
            .map((row) => Map<String, dynamic>.from(row as Map))
            .toList();

        final professional =
            profile['professional_name']?.toString().trim() ?? '';

        final fullName = profile['full_name']?.toString().trim() ?? '';

        final name = professional.isNotEmpty
            ? professional
            : fullName.isNotEmpty
            ? fullName
            : 'Wellness Provider';

        final business = profile['business_name']?.toString().trim() ?? '';

        final bio = profile['bio']?.toString().trim() ?? '';

        final area = profile['service_area']?.toString().trim() ?? '';

        final photo = profile['profile_photo_url']?.toString().trim() ?? '';

        final available = profile['available_now'] == true;

        final rating =
            double.tryParse(profile['rating']?.toString() ?? '') ?? 0;

        final reviewCount =
            int.tryParse(profile['review_count']?.toString() ?? '') ?? 0;

        final specialties = <String>{};

