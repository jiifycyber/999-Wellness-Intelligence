                      )
                    : null,
                border: Border.all(
                  color: active
                      ? const Color(0xFFA48CFF)
                      : _hovered
                      ? const Color(0xFF6F85D8).withValues(alpha: .52)
                      : Colors.transparent,
                ),
                boxShadow: highlight
                    ? [
                        BoxShadow(
                          color: const Color(0xFF6845FF)
                              .withValues(alpha: active ? .34 : .11),
                          blurRadius: active ? 30 : 18,
                          spreadRadius: active ? 1 : 0,
                        ),
                        if (active)
                          BoxShadow(
                            color: const Color(0xFF39D6FF)
