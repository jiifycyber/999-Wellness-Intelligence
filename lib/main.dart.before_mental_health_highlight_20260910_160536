  Future<void> _loadProviderBookings() async {
    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) {
      if (!mounted) return;

      setState(() {
        _bookingsError = 'Provider session not found.';
        _bookingsLoading = false;
      });

      return;
    }

    setState(() {
      _bookingsLoading = true;
      _bookingsError = null;
    });

    try {
      final data = await Supabase.instance.client
          .from('bookings')
          .select(
            'id, customer_id, provider_id, provider_name, service_name, '
            'booking_day, booking_time, service_type, service_address, '
            'customer_name, customer_phone, customer_email, '
            'preferred_contact_method, access_instructions, booking_notes, '
            'status, payment_status, eta_minutes, price, created_at, updated_at',
          )
          .eq('provider_id', user.id)
          .order('created_at', ascending: false);

      final rows = (data as List)
          .map((row) => Map<String, dynamic>.from(row as Map))
          .toList();

      if (!mounted) return;

      setState(() {
        _providerBookings = rows;
        _bookingsLoading = false;
      });
    } catch (error) {
      if (!mounted) return;

      setState(() {
        _bookingsError = error.toString();
        _bookingsLoading = false;
      });
    }
  }

  Future<void> _updateProviderBookingStatus(
    String bookingId,
    String newStatus, {
    int? etaMinutes,
  }) async {
    try {
      final updateData = <String, dynamic>{
        'status': newStatus,
        'updated_at': DateTime.now().toIso8601String(),
      };

      if (etaMinutes != null) {
        updateData['eta_minutes'] = etaMinutes;
      }

      await Supabase.instance.client
          .from('bookings')
          .update(updateData)
          .eq('id', bookingId);

      await _loadProviderBookings();

      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          behavior: SnackBarBehavior.floating,
          backgroundColor: const Color(0xFF171126),
          content: Text('Booking updated to $newStatus'),
        ),
      );
    } catch (error) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          behavior: SnackBarBehavior.floating,
          backgroundColor: const Color(0xFF40151F),
          content: Text('Unable to update booking: $error'),
        ),
      );
    }
  }

