  int _providerAiRepeatClients() {
    final counts = <String, int>{};

    for (final booking in _providerBookings) {
      final key = _providerAiCustomerKey(booking);

      if (key.isEmpty) {
        continue;
      }

      counts[key] = (counts[key] ?? 0) + 1;
    }

    return counts.values.where((count) => count > 1).length;
  }

  double _providerAiRepeatRate() {
    final counts = <String, int>{};

    for (final booking in _providerBookings) {
      final key = _providerAiCustomerKey(booking);

      if (key.isEmpty) {
        continue;
      }

      counts[key] = (counts[key] ?? 0) + 1;
    }

    if (counts.isEmpty) {
      return 0;
    }

    final repeat = counts.values.where((count) => count > 1).length;

    return repeat / counts.length * 100;
  }

  String _providerAiTopService() {
    final counts = <String, int>{};

    for (final booking in _providerBookings) {
      final service = booking['service_name']?.toString().trim() ?? '';

      if (service.isEmpty) {
        continue;
      }

      counts[service] = (counts[service] ?? 0) + 1;
    }

    if (counts.isEmpty) {
      return 'No service data yet';
    }

    String best = counts.keys.first;
    int bestCount = counts[best] ?? 0;

    for (final entry in counts.entries) {
      if (entry.value > bestCount) {
        best = entry.key;
        bestCount = entry.value;
      }
    }

    return best;
  }

