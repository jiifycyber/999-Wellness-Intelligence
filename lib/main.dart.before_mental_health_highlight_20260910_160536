  const _CustomerMessagesV3Screen();

  @override
  State<_CustomerMessagesV3Screen> createState() =>
      _CustomerMessagesV3ScreenState();
}

class _CustomerMessagesV3ScreenState extends State<_CustomerMessagesV3Screen> {
  final TextEditingController _conversationSearch = TextEditingController();
  final TextEditingController _messageController = TextEditingController();

  List<Map<String, dynamic>> _providers = [];
  List<Map<String, dynamic>> _conversations = [];
  List<Map<String, dynamic>> _activeMessages = [];

  Map<String, dynamic>? _selectedProvider;

  bool _loading = true;
  bool _chatLoading = false;
  bool _sending = false;

  String? _error;
  String _query = '';

  @override
  void initState() {
    super.initState();
    _loadMessagingNetwork();
  }

  @override
  void dispose() {
    _conversationSearch.dispose();
    _messageController.dispose();
    super.dispose();
  }

  String _initials(String name) {
    final parts = name
        .trim()
        .split(RegExp(r'\s+'))
        .where((part) => part.isNotEmpty)
        .toList();

    if (parts.isEmpty) return 'WP';

    if (parts.length == 1) {
      final word = parts.first.toUpperCase();
      return word.length > 1 ? word.substring(0, 2) : word;
    }

    return '${parts.first[0]}${parts.last[0]}'.toUpperCase();
  }

  String _providerName(Map<String, dynamic> row) {
    final professional = row['professional_name']?.toString().trim() ?? '';
    final fullName = row['full_name']?.toString().trim() ?? '';

    if (professional.isNotEmpty) return professional;
    if (fullName.isNotEmpty) return fullName;

    return 'Wellness Provider';
  }

  String _shortTime(dynamic value) {
    final raw = value?.toString() ?? '';
    final date = DateTime.tryParse(raw)?.toLocal();

    if (date == null) return '';

    final hour = date.hour == 0
        ? 12
        : date.hour > 12
        ? date.hour - 12
        : date.hour;

    final minute = date.minute.toString().padLeft(2, '0');
    final suffix = date.hour >= 12 ? 'PM' : 'AM';

    return '$hour:$minute $suffix';
  }

  Future<void> _loadMessagingNetwork() async {
    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) {
      if (!mounted) return;

      setState(() {
        _loading = false;
        _error = 'Please sign in to use messaging.';
      });

      return;
    }

    try {
      final providerData = await Supabase.instance.client
          .from('provider_profiles')
          .select(
            'id, full_name, professional_name, business_name, '
            'service_area, available_now, profile_photo_url',
          )
          .order('professional_name');

      final sentData = await Supabase.instance.client
          .from('messages')
          .select(
            'id, sender_id, receiver_id, message, read_at, created_at, '
            'attachment_path, attachment_name, attachment_type',
          )
          .eq('sender_id', user.id);

      final receivedData = await Supabase.instance.client
          .from('messages')
          .select(
            'id, sender_id, receiver_id, message, read_at, created_at, '
            'attachment_path, attachment_name, attachment_type',
          )
          .eq('receiver_id', user.id);

      final providerRows = (providerData as List)
          .map((row) => Map<String, dynamic>.from(row as Map))
          .toList();

      final mappedProviders = providerRows
          .map((row) {
            final name = _providerName(row);

            return <String, dynamic>{
              'id': row['id']?.toString() ?? '',
              'name': name,
              'initials': _initials(name),
              'business_name': row['business_name']?.toString() ?? '',
              'service_area': row['service_area']?.toString() ?? '',
              'available_now': row['available_now'] == true,
              'profile_photo_url': row['profile_photo_url']?.toString() ?? '',
            };
          })
          .where((row) {
            return row['id'].toString().isNotEmpty;
          })
          .toList();

      final providerById = <String, Map<String, dynamic>>{
        for (final provider in mappedProviders)
          provider['id'].toString(): provider,
      };

      final messages = <Map<String, dynamic>>[];

      for (final row in sentData as List) {
        messages.add(Map<String, dynamic>.from(row as Map));
      }

      for (final row in receivedData as List) {
        messages.add(Map<String, dynamic>.from(row as Map));
      }

      final seenIds = <String>{};

      messages.removeWhere((row) {
        final id = row['id']?.toString() ?? '';

        if (id.isEmpty) return false;

        if (seenIds.contains(id)) {
          return true;
        }

        seenIds.add(id);
        return false;
      });

      messages.sort((a, b) {
        final left = a['created_at']?.toString() ?? '';
        final right = b['created_at']?.toString() ?? '';
        return right.compareTo(left);
      });

      final conversationByProvider = <String, Map<String, dynamic>>{};

      for (final message in messages) {
        final sender = message['sender_id']?.toString() ?? '';
        final receiver = message['receiver_id']?.toString() ?? '';

        final providerId = sender == user.id ? receiver : sender;

        final provider = providerById[providerId];

        if (provider == null) continue;

        final current = conversationByProvider[providerId];

        final unread =
            sender == providerId &&
            receiver == user.id &&
            message['read_at'] == null;

        if (current == null) {
          conversationByProvider[providerId] = {
            'provider': provider,
            'last_message': message['message']?.toString() ?? '',
            'created_at': message['created_at']?.toString() ?? '',
            'unread_count': unread ? 1 : 0,
          };
        } else if (unread) {
          current['unread_count'] = (current['unread_count'] as int? ?? 0) + 1;
        }
      }

      final conversations = conversationByProvider.values.toList();

      conversations.sort((a, b) {
        return b['created_at'].toString().compareTo(a['created_at'].toString());
      });

      final conversationIds = conversations
          .map(
            (row) => (row['provider'] as Map<String, dynamic>)['id'].toString(),
          )
          .toSet();

      final orderedProviders = <Map<String, dynamic>>[];

      for (final conversation in conversations) {
        orderedProviders.add(
          Map<String, dynamic>.from(conversation['provider'] as Map),
        );
      }

      for (final provider in mappedProviders) {
        if (!conversationIds.contains(provider['id'].toString())) {
          orderedProviders.add(provider);
        }
      }

      Map<String, dynamic>? selected = _selectedProvider;

      if (selected != null) {
        final selectedId = selected['id']?.toString();

        selected = orderedProviders
            .where((provider) => provider['id']?.toString() == selectedId)
            .cast<Map<String, dynamic>?>()
            .firstOrNull;
      }

      if (!mounted) return;

      setState(() {
        _providers = orderedProviders;
        _conversations = conversations;
        _selectedProvider = selected;
        _loading = false;
        _error = null;
      });
    } catch (error) {
      if (!mounted) return;

      setState(() {
        _loading = false;
        _error = 'Unable to load your messaging network.';
      });
    }
  }

  Future<void> _selectProvider(Map<String, dynamic> provider) async {
    setState(() {
      _selectedProvider = provider;
      _chatLoading = true;
      _activeMessages = [];
