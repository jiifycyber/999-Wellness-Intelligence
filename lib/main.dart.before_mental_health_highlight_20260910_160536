    String photoUrl = '';

    try {
      final bookingRaw = await Supabase.instance.client
          .from('bookings')
          .select('id, status')
          .eq('provider_id', user.id);

      bookingRequests = (bookingRaw as List).where((row) {
        final booking = Map<String, dynamic>.from(row as Map);
        return booking['status']?.toString().trim().toLowerCase() ==
