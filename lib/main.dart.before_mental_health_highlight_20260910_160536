class _V2FeaturedProvidersPanelState extends State<_V2FeaturedProvidersPanel> {
  late final Future<List<Map<String, dynamic>>> _providersFuture;

  @override
  void initState() {
    super.initState();
    _providersFuture = _loadProviders();
  }

  String _initials(String name) {
    final parts = name
        .trim()
        .split(RegExp(r'\s+'))
        .where((part) => part.isNotEmpty)
        .toList();

    if (parts.isEmpty) return 'WP';

    if (parts.length == 1) {
      final word = parts.first.toUpperCase();
      return word.length > 1 ? word.substring(0, 2) : word;
    }

    return '${parts.first[0]}${parts.last[0]}'.toUpperCase();
  }

  Future<List<Map<String, dynamic>>> _loadProviders() async {
    final rows = await Supabase.instance.client
        .from('provider_profiles')
        .select(
          'id, full_name, professional_name, business_name, '
          'service_area, rating, available_now, profile_photo_url',
        )
        .order('professional_name')
        .limit(3);

    return (rows as List)
        .map((row) => Map<String, dynamic>.from(row as Map))
        .toList();
  }

  @override
  Widget build(BuildContext context) {
    return _V2GlassPanel(
      title: 'FEATURED PROVIDERS',
      trailing: 'LIVE NETWORK',
      child: FutureBuilder<List<Map<String, dynamic>>>(
        future: _providersFuture,
        builder: (context, snapshot) {
          if (snapshot.connectionState == ConnectionState.waiting) {
            return const Padding(
              padding: EdgeInsets.symmetric(vertical: 25),
              child: Center(child: CircularProgressIndicator()),
            );
          }

          if (snapshot.hasError) {
            return const Padding(
              padding: EdgeInsets.symmetric(vertical: 22),
              child: Center(
                child: Text(
                  'Unable to load providers.',
                  style: TextStyle(color: Colors.white54, fontSize: 10),
                ),
              ),
            );
          }

          final providers = snapshot.data ?? const <Map<String, dynamic>>[];

          if (providers.isEmpty) {
            return const Padding(
              padding: EdgeInsets.symmetric(vertical: 24),
              child: Center(
                child: Column(
                  children: [
                    Icon(
                      Icons.person_search_rounded,
                      color: Color(0xFF7380AA),
                      size: 30,
                    ),
                    SizedBox(height: 9),
                    Text(
                      'No providers available yet',
                      style: TextStyle(
                        color: Colors.white70,
                        fontWeight: FontWeight.w800,
                      ),
                    ),
                  ],
                ),
              ),
            );
          }

          return Column(
            children: [
              for (int i = 0; i < providers.length; i++) ...[
                Builder(
                  builder: (context) {
                    final provider = providers[i];

                    final professional =
                        provider['professional_name']?.toString().trim() ?? '';

                    final fullName =
                        provider['full_name']?.toString().trim() ?? '';

                    final name = professional.isNotEmpty
                        ? professional
                        : fullName.isNotEmpty
                        ? fullName
                        : 'Wellness Provider';

                    final business =
                        provider['business_name']?.toString().trim() ?? '';

                    final serviceArea =
                        provider['service_area']?.toString().trim() ?? '';

                    final ratingValue = double.tryParse(
                      provider['rating']?.toString() ?? '',
                    );

                    final available = provider['available_now'] == true;

                    return _V2ProviderRow(
                      initials: _initials(name),
                      photoUrl: provider['profile_photo_url']?.toString() ?? '',
                      name: name,
                      specialty: business.isNotEmpty
                          ? business
                          : 'Wellness Provider',
                      location: serviceArea.isNotEmpty
                          ? serviceArea
                          : available
                          ? 'Available Now'
                          : 'Service Area Updating',
                      rating: ratingValue != null && ratingValue > 0
                          ? ratingValue.toStringAsFixed(1)
                          : 'NEW',
                      onTap: () => widget.onProviderTap(name),
                    );
                  },
                ),
                if (i != providers.length - 1) const SizedBox(height: 8),
              ],
            ],
          );
        },
      ),
    );
  }
}

