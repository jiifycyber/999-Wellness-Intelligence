    String dateLabel(DateTime value) {
      const months = [
        'Jan',
        'Feb',
        'Mar',
        'Apr',
        'May',
        'Jun',
        'Jul',
        'Aug',
        'Sep',
        'Oct',
        'Nov',
        'Dec',
      ];

      return '${months[value.month - 1]} ${value.day}, ${value.year}';
    }

    String timeLabel(TimeOfDay value) {
      final suffix = value.hour >= 12 ? 'PM' : 'AM';
      final hour = value.hour == 0
          ? 12
          : value.hour > 12
          ? value.hour - 12
          : value.hour;

      return '${hour.toString().padLeft(2, '0')}:'
          '${value.minute.toString().padLeft(2, '0')} $suffix';
    }

    DateTime combineDateAndTime(DateTime date, TimeOfDay time) {
      return DateTime(date.year, date.month, date.day, time.hour, time.minute);
    }

    String blockedRowDate(dynamic value) {
      final parsed = DateTime.tryParse(value?.toString() ?? '');

      if (parsed == null) {
        return value?.toString() ?? '';
      }

      return dateLabel(parsed.toLocal());
    }

    String blockedRowTime(dynamic value) {
      final parsed = DateTime.tryParse(value?.toString() ?? '');

      if (parsed == null) {
        return '';
      }

      final local = parsed.toLocal();

      return timeLabel(TimeOfDay(hour: local.hour, minute: local.minute));
    }

    Future<void> saveBlockedPeriod(
      BuildContext dialogContext,
      StateSetter setDialogState,
    ) async {
      final start = combineDateAndTime(selectedDate, startTime);
      final end = combineDateAndTime(selectedDate, endTime);

      if (!end.isAfter(start)) {
        ScaffoldMessenger.of(dialogContext).showSnackBar(
          const SnackBar(
            behavior: SnackBarBehavior.floating,
            content: Text('End time must be later than start time.'),
          ),
        );
        return;
      }

      final custom = customReasonController.text.trim();
      final finalReason = custom.isNotEmpty ? custom : reason;

      setDialogState(() {
        saving = true;
      });

      try {
        await Supabase.instance.client.from('provider_blocked_times').insert({
          'provider_id': user.id,
          'start_at': start.toUtc().toIso8601String(),
          'end_at': end.toUtc().toIso8601String(),
          'reason': finalReason,
        });

        await _loadScheduleData();

        if (!dialogContext.mounted) {
          return;
        }

        setDialogState(() {
          saving = false;
        });

        ScaffoldMessenger.of(dialogContext).showSnackBar(
          const SnackBar(
            behavior: SnackBarBehavior.floating,
            content: Text('Blocked time added.'),
          ),
        );
      } catch (error) {
        if (!dialogContext.mounted) {
          return;
        }

        setDialogState(() {
          saving = false;
