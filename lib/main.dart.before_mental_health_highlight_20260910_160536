  double _providerBookingPrice(Map<String, dynamic> booking) {
    return double.tryParse(booking['price']?.toString() ?? '') ?? 0;
  }

  DateTime? _providerPaymentDate(Map<String, dynamic> booking) {
    final raw = booking['payment_completed_at']?.toString();

    if (raw == null || raw.trim().isEmpty) {
      return null;
    }

    return DateTime.tryParse(raw)?.toLocal();
  }

  Future<void> _showProviderEarnings(String view) async {
    await _loadProviderEarnings();

    if (!mounted) {
      return;
    }

    final now = DateTime.now();

    List<Map<String, dynamic>> rows = List<Map<String, dynamic>>.from(
      _paidProviderBookings,
    );

    if (view == 'Today') {
      rows = rows.where((booking) {
        final paidAt = _providerPaymentDate(booking);

        if (paidAt == null) {
          return false;
        }

        return paidAt.year == now.year &&
            paidAt.month == now.month &&
            paidAt.day == now.day;
      }).toList();
    }

    if (view == 'This Week') {
      final startOfWeek = DateTime(
        now.year,
        now.month,
        now.day,
      ).subtract(Duration(days: now.weekday - 1));

      rows = rows.where((booking) {
        final paidAt = _providerPaymentDate(booking);

        if (paidAt == null) {
          return false;
        }

        return !paidAt.isBefore(startOfWeek);
      }).toList();
    }

    final revenue = rows.fold<double>(
      0,
      (total, booking) => total + _providerBookingPrice(booking),
    );

    final lifetimeRevenue = _paidProviderBookings.fold<double>(
      0,
      (total, booking) => total + _providerBookingPrice(booking),
    );

    final average = _paidProviderBookings.isEmpty
        ? 0.0
