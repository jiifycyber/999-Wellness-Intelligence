  Future<void> _loadProviderMedia() async {
    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) return;

    setState(() {
      _mediaLoading = true;
    });

    try {
      final profile = await Supabase.instance.client
          .from('provider_profiles')
          .select('profile_photo_url')
          .eq('id', user.id)
          .maybeSingle();

      final mediaData = await Supabase.instance.client
          .from('provider_media')
          .select(
            'id, provider_id, media_type, storage_path, public_url, file_name, created_at',
          )
          .eq('provider_id', user.id)
          .order('created_at', ascending: false);

      final rows = (mediaData as List)
          .map((row) => Map<String, dynamic>.from(row as Map))
          .toList();

      if (!mounted) return;

      setState(() {
        _providerProfilePhotoUrl =
            profile?['profile_photo_url']?.toString() ?? '';

        _providerPhotoMedia = rows
            .where((row) => row['media_type']?.toString() == 'photo')
            .toList();

        _providerVideoMedia = rows
            .where((row) => row['media_type']?.toString() == 'video')
            .toList();

        _mediaLoading = false;
      });
    } catch (error) {
      if (!mounted) return;

      setState(() {
        _mediaLoading = false;
      });

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Unable to load provider media: $error')),
      );
    }
  }

  String _safeProviderMediaName(String name) {
    return name
        .replaceAll(RegExp(r'[^A-Za-z0-9._-]'), '_')
        .replaceAll(RegExp(r'_+'), '_');
  }

  Future<void> _pickAndUploadProviderMedia(String kind) async {
    if (_mediaUploading) return;

    final user = Supabase.instance.client.auth.currentUser;
    if (user == null) return;

    final isVideo = kind == 'video';
    final isProfile = kind == 'profile';

    try {
      final pickedFiles = await FilePicker.pickFiles(
        type: FileType.custom,
        allowedExtensions: isVideo
            ? const ['mp4', 'mov', 'm4v', 'webm']
            : const ['jpg', 'jpeg', 'png', 'webp', 'heic', 'heif'],
        allowMultiple: kind == 'photo',
      );

      if (pickedFiles.isEmpty) return;

      setState(() {
        _mediaUploading = true;
      });

      final files = isProfile ? <PlatformFile>[pickedFiles.first] : pickedFiles;

      for (final file in files) {
        final bytes = await file.readAsBytes();

        final extension = (file.extension ?? (isVideo ? 'mp4' : 'jpg'))
            .toLowerCase();

        final safeName = _safeProviderMediaName(file.name);
        final stamp = DateTime.now().microsecondsSinceEpoch;

        final storagePath = isProfile
            ? '${user.id}/profile/profile_$stamp.$extension'
            : '${user.id}/$kind/${stamp}_$safeName';

        await Supabase.instance.client.storage
            .from('provider-media')
            .uploadBinary(
              storagePath,
              bytes,
              fileOptions: const FileOptions(upsert: false),
            );

        final publicUrl = Supabase.instance.client.storage
            .from('provider-media')
            .getPublicUrl(storagePath);

        if (isProfile) {
          await Supabase.instance.client
              .from('provider_profiles')
              .update({'profile_photo_url': publicUrl})
              .eq('id', user.id);
        } else {
          await Supabase.instance.client.from('provider_media').insert({
            'provider_id': user.id,
            'media_type': kind,
            'storage_path': storagePath,
            'public_url': publicUrl,
            'file_name': file.name,
          });
        }
      }

      await _loadProviderMedia();

      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            isProfile
                ? 'Profile photo updated.'
                : isVideo
                ? 'Video added.'
                : 'Photo added.',
          ),
        ),
      );
    } catch (error) {
      if (!mounted) return;

      ScaffoldMessenger.of(context)
          .showSnackBar(SnackBar(content: Text('Upload failed: $error')));
    } finally {
      if (mounted) {
        setState(() {
          _mediaUploading = false;
        });
      }
    }
  }

  void _openProviderPhotoViewer(Map<String, dynamic> selectedMedia) {
    final urls = _providerPhotoMedia
        .map((media) => media['public_url']?.toString() ?? '')
        .where((url) => url.isNotEmpty)
        .toList();

    final selectedUrl = selectedMedia['public_url']?.toString() ?? '';

    if (urls.isEmpty || selectedUrl.isEmpty) {
      return;
    }

    final initialIndex = urls.indexOf(selectedUrl);

    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (_) => _ProviderPhotoViewer(
          urls: urls,
          initialIndex: initialIndex < 0 ? 0 : initialIndex,
        ),
      ),
    );
  }

  void _openProviderVideoViewer(Map<String, dynamic> media) {
    final url = media['public_url']?.toString() ?? '';

    if (url.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Video URL is unavailable.')),
      );
      return;
    }

    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (_) => _ProviderVideoViewer(
          url: url,
          title: media['file_name']?.toString() ?? 'Provider Video',
        ),
      ),
    );
  }

  Future<void> _deleteProviderMedia(Map<String, dynamic> media) async {
    final id = media['id']?.toString() ?? '';
    final storagePath = media['storage_path']?.toString() ?? '';

    if (id.isEmpty) return;

    try {
      if (storagePath.isNotEmpty) {
        await Supabase.instance.client.storage.from('provider-media').remove([
          storagePath,
        ]);
      }

      await Supabase.instance.client
          .from('provider_media')
          .delete()
          .eq('id', id);

      await _loadProviderMedia();
    } catch (error) {
      if (!mounted) return;

      ScaffoldMessenger.of(
        context,
      ).showSnackBar(SnackBar(content: Text('Unable to remove media: $error')));
    }
  }

