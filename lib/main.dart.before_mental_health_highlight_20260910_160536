  Future<void> _loadConversation(Map<String, dynamic> provider) async {
    final user = Supabase.instance.client.auth.currentUser;
    final providerId = provider['id']?.toString() ?? '';

    if (user == null || providerId.isEmpty) {
      if (!mounted) return;

      setState(() {
        _chatLoading = false;
      });

      return;
    }

    try {
      final sent = await Supabase.instance.client
          .from('messages')
          .select(
            'id, sender_id, receiver_id, message, read_at, created_at, '
            'attachment_path, attachment_name, attachment_type',
          )
          .eq('sender_id', user.id)
          .eq('receiver_id', providerId);

      final received = await Supabase.instance.client
          .from('messages')
          .select(
            'id, sender_id, receiver_id, message, read_at, created_at, '
            'attachment_path, attachment_name, attachment_type',
          )
          .eq('sender_id', providerId)
          .eq('receiver_id', user.id);

      final rows = <Map<String, dynamic>>[];

      for (final row in sent as List) {
        rows.add(Map<String, dynamic>.from(row as Map));
      }

      for (final row in received as List) {
        rows.add(Map<String, dynamic>.from(row as Map));
      }

      rows.sort((a, b) {
        final left = a['created_at']?.toString() ?? '';
        final right = b['created_at']?.toString() ?? '';
        return left.compareTo(right);
      });

      if (!mounted) return;

      setState(() {
        _activeMessages = rows;
        _chatLoading = false;
      });
    } catch (_) {
      if (!mounted) return;

      setState(() {
        _chatLoading = false;
      });
    }
  }

  String _customerChatMimeType(String fileName) {
    final lower = fileName.toLowerCase();

    if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) {
      return 'image/jpeg';
    }
    if (lower.endsWith('.png')) return 'image/png';
    if (lower.endsWith('.webp')) return 'image/webp';
    if (lower.endsWith('.gif')) return 'image/gif';
    if (lower.endsWith('.heic')) return 'image/heic';
    if (lower.endsWith('.heif')) return 'image/heif';
    if (lower.endsWith('.mov')) return 'video/quicktime';
    if (lower.endsWith('.webm')) return 'video/webm';

    return 'video/mp4';
  }

  bool _customerChatIsVideo(dynamic type, dynamic path) {
    final mediaType = type?.toString().toLowerCase() ?? '';
    final mediaPath = path?.toString().toLowerCase() ?? '';

    return mediaType.startsWith('video/') ||
        mediaPath.endsWith('.mp4') ||
        mediaPath.endsWith('.mov') ||
        mediaPath.endsWith('.webm');
  }

  Future<String> _customerChatSignedUrl(dynamic pathValue) async {
    final storagePath = pathValue?.toString().trim() ?? '';

    if (storagePath.isEmpty) {
      return '';
    }

    try {
      return await Supabase.instance.client.storage
          .from('chat-media')
          .createSignedUrl(storagePath, 3600);
    } catch (_) {
      return '';
    }
  }

  Future<void> _pickAndSendCustomerAttachment() async {
    final user = Supabase.instance.client.auth.currentUser;
    final provider = _selectedProvider;

    if (user == null || provider == null || _sending) {
      return;
    }

    final providerId = provider['id']?.toString() ?? '';

    if (providerId.isEmpty) {
      return;
    }

    final picked = await FilePicker.pickFiles(
      type: FileType.custom,
      allowedExtensions: const [
        'jpg',
        'jpeg',
        'png',
        'webp',
        'gif',
        'heic',
        'heif',
        'mp4',
        'mov',
        'webm',
      ],
    );

    if (picked.isEmpty) {
      return;
    }

    final file = picked.first;
    final bytes = await file.readAsBytes();
    final mimeType = _customerChatMimeType(file.name);
    final isVideo = mimeType.startsWith('video/');

    final limit = isVideo ? 52428800 : 10485760;

    if (bytes.length > limit) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          behavior: SnackBarBehavior.floating,
          content: Text(
            isVideo
                ? 'Video must be 50 MB or smaller.'
                : 'Image must be 10 MB or smaller.',
          ),
        ),
      );
      return;
    }

    setState(() {
      _sending = true;
    });

    try {
      final safeName = file.name.replaceAll(RegExp(r'[^A-Za-z0-9._-]'), '_');

      final stamp = DateTime.now().microsecondsSinceEpoch;

      final storagePath = '${user.id}/$providerId/${stamp}_$safeName';

      await Supabase.instance.client.storage
          .from('chat-media')
          .uploadBinary(
            storagePath,
            bytes,
            fileOptions: FileOptions(upsert: false, contentType: mimeType),
          );

      final caption = _messageController.text.trim();

      await Supabase.instance.client.from('messages').insert({
        'sender_id': user.id,
        'receiver_id': providerId,
        'message': caption,
        'attachment_path': storagePath,
        'attachment_name': file.name,
        'attachment_type': mimeType,
      });

      _messageController.clear();

      await _loadConversation(provider);
      await _loadMessagingNetwork();
    } catch (error) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          behavior: SnackBarBehavior.floating,
          content: Text('Attachment could not be sent: $error'),
        ),
      );
    } finally {
      if (mounted) {
        setState(() {
          _sending = false;
        });
      }
    }
  }

  Future<void> _sendMessage() async {
    final user = Supabase.instance.client.auth.currentUser;
    final provider = _selectedProvider;

    if (user == null || provider == null || _sending) return;

    final providerId = provider['id']?.toString() ?? '';
    final body = _messageController.text.trim();

    if (providerId.isEmpty || body.isEmpty) return;

    setState(() {
      _sending = true;
    });

    try {
      await Supabase.instance.client.from('messages').insert({
        'sender_id': user.id,
        'receiver_id': providerId,
        'message': body,
      });

      _messageController.clear();

      await _loadConversation(provider);
      await _loadMessagingNetwork();
    } catch (_) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Message could not be sent.')),
      );
    } finally {
      if (mounted) {
        setState(() {
          _sending = false;
        });
      }
    }
  }

  List<Map<String, dynamic>> get _visibleConversations {
    final q = _query.trim().toLowerCase();

    if (q.isEmpty) return _conversations;

    return _conversations.where((conversation) {
      final provider = conversation['provider'] as Map<String, dynamic>;

      final name = provider['name'].toString().toLowerCase();
      final body = conversation['last_message'].toString().toLowerCase();

      return name.contains(q) || body.contains(q);
    }).toList();
  }

  int get _unreadCount {
    return _conversations.fold<int>(
      0,
      (total, conversation) =>
          total + (conversation['unread_count'] as int? ?? 0),
    );
  }

