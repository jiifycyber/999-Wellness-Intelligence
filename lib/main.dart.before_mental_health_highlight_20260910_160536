  DateTime? _providerAiDate(dynamic value) {
    final raw = value?.toString().trim() ?? '';

    if (raw.isEmpty) {
      return null;
    }

    final parsed = DateTime.tryParse(raw);

    if (parsed != null) {
      return parsed.toLocal();
    }

    return null;
  }

  bool _providerAiIsToday(dynamic value) {
    final raw = value?.toString().trim() ?? '';

    if (raw.isEmpty) {
      return false;
    }

    final now = DateTime.now();

    final isoDay =
        '${now.year.toString().padLeft(4, '0')}-'
        '${now.month.toString().padLeft(2, '0')}-'
        '${now.day.toString().padLeft(2, '0')}';

    if (raw.startsWith(isoDay) || raw.contains(isoDay)) {
      return true;
    }

    final parsed = _providerAiDate(value);

    if (parsed == null) {
      return false;
    }

    return parsed.year == now.year &&
        parsed.month == now.month &&
        parsed.day == now.day;
  }

  DateTime? _providerAiBookingDate(Map<String, dynamic> booking) {
    const keys = [
      'completed_at',
      'paid_at',
      'booking_day',
      'updated_at',
      'created_at',
    ];

    for (final key in keys) {
      final parsed = _providerAiDate(booking[key]);

      if (parsed != null) {
        return parsed;
      }
    }

    return null;
  }

  double _providerAiMoneyValue(dynamic value) {
    if (value is num) {
      return value.toDouble();
    }

    return double.tryParse(
          value?.toString().replaceAll(r'$', '').replaceAll(',', '').trim() ??
              '',
        ) ??
        0;
  }

  double _providerAiBookingRevenue(Map<String, dynamic> booking) {
    const keys = [
      'provider_amount',
      'provider_earnings',
      'net_amount',
      'amount',
      'total_amount',
      'price',
    ];

    for (final key in keys) {
      final amount = _providerAiMoneyValue(booking[key]);

      if (amount > 0) {
        return amount;
      }
    }

    return 0;
  }

  String _providerAiCurrency(double value) {
    final amount = value.round();
    final negative = amount < 0;
    var digits = amount.abs().toString();
    final groups = <String>[];

    while (digits.length > 3) {
      groups.insert(0, digits.substring(digits.length - 3));
      digits = digits.substring(0, digits.length - 3);
    }

    groups.insert(0, digits);

    return '${negative ? '-' : ''}\$${groups.join(',')}';
  }

