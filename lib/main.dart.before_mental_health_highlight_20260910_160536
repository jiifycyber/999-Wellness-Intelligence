  double _providerAiThisWeekRevenue() {
    final now = DateTime.now();

    final start = DateTime(
      now.year,
      now.month,
      now.day,
    ).subtract(Duration(days: now.weekday - 1));

    final end = start.add(const Duration(days: 7));

    double total = 0;

    for (final booking in _paidProviderBookings) {
      final date = _providerAiBookingDate(booking);

      if (date == null) {
        continue;
      }

      if (!date.isBefore(start) && date.isBefore(end)) {
        total += _providerAiBookingRevenue(booking);
      }
    }

    return total;
  }

  double _providerAiLastWeekRevenue() {
    final now = DateTime.now();

    final thisWeek = DateTime(
      now.year,
      now.month,
      now.day,
    ).subtract(Duration(days: now.weekday - 1));

    final start = thisWeek.subtract(const Duration(days: 7));
    final end = thisWeek;

    double total = 0;

    for (final booking in _paidProviderBookings) {
      final date = _providerAiBookingDate(booking);

      if (date == null) {
        continue;
      }

      if (!date.isBefore(start) && date.isBefore(end)) {
        total += _providerAiBookingRevenue(booking);
      }
    }

    return total;
  }

  double _providerAiTodayRevenue() {
    double total = 0;

    for (final booking in _paidProviderBookings) {
      final date = _providerAiBookingDate(booking);

      if (date == null) {
        continue;
      }

      final now = DateTime.now();

      if (date.year == now.year &&
          date.month == now.month &&
          date.day == now.day) {
        total += _providerAiBookingRevenue(booking);
      }
    }

    return total;
  }

  double _providerAiAverageSession() {
    if (_paidProviderBookings.isEmpty) {
      return 0;
    }

    double total = 0;
    int count = 0;

    for (final booking in _paidProviderBookings) {
      final amount = _providerAiBookingRevenue(booking);

      if (amount > 0) {
        total += amount;
        count++;
      }
    }

    if (count == 0) {
      return 0;
    }

    return total / count;
  }

  double _providerAiRevenueChange() {
    final current = _providerAiThisWeekRevenue();
    final previous = _providerAiLastWeekRevenue();

    if (previous <= 0) {
      return current > 0 ? 100 : 0;
    }

    return ((current - previous) / previous) * 100;
  }

