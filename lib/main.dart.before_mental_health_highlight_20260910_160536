class _CurrentUserTopBarAvatar extends StatefulWidget {
  const _CurrentUserTopBarAvatar();

  @override
  State<_CurrentUserTopBarAvatar> createState() =>
      _CurrentUserTopBarAvatarState();
}

class _CurrentUserTopBarAvatarState extends State<_CurrentUserTopBarAvatar> {
  late Future<String> _photoFuture;

  @override
  void initState() {
    super.initState();
    _photoFuture = _loadProfilePhoto();
  }

  Future<String> _loadProfilePhoto() async {
    final user = Supabase.instance.client.auth.currentUser;
    if (user == null) return '';

    String role = '';

    try {
      final profile = await Supabase.instance.client
          .from('profiles')
          .select('role')
          .eq('id', user.id)
          .maybeSingle();

      role = profile?['role']?.toString().trim().toLowerCase() ?? '';
    } catch (_) {}

    Future<String> providerPhoto() async {
      try {
        final row = await Supabase.instance.client
            .from('provider_profiles')
            .select('profile_photo_url')
            .eq('id', user.id)
            .maybeSingle();

        return row?['profile_photo_url']?.toString().trim() ?? '';
      } catch (_) {
        return '';
      }
    }

    Future<String> customerPhoto() async {
      try {
        final row = await Supabase.instance.client
            .from('community_member_profiles')
            .select('photo_url, photo_path')
            .eq('user_id', user.id)
            .maybeSingle();

        if (row == null) return '';

        final path = row['photo_path']?.toString().trim() ?? '';

        if (path.isNotEmpty) {
          try {
            return await Supabase.instance.client.storage
                .from('community-profile-media')
                .createSignedUrl(path, 3600);
          } catch (_) {}
        }

        return row['photo_url']?.toString().trim() ?? '';
      } catch (_) {
        return '';
      }
    }

    if (role == 'provider') {
      final photo = await providerPhoto();
      if (photo.isNotEmpty) return photo;
      return customerPhoto();
    }

    final photo = await customerPhoto();
    if (photo.isNotEmpty) return photo;
    return providerPhoto();
  }

  Widget _fallbackAvatar() {
    return const Center(
      child: Icon(Icons.person_rounded, size: 17, color: Colors.white),
    );
  }

  @override
  Widget build(BuildContext context) {
    return FutureBuilder<String>(
      future: _photoFuture,
      builder: (context, snapshot) {
        final photoUrl = snapshot.data?.trim() ?? '';

        return Container(
          width: 34,
          height: 34,
          padding: const EdgeInsets.all(2),
          decoration: BoxDecoration(
            shape: BoxShape.circle,
            gradient: const LinearGradient(
              begin: Alignment.topLeft,
              end: Alignment.bottomRight,
              colors: [Color(0xFFB14DFF), Color(0xFF7048FF), Color(0xFF43D8FF)],
            ),
            boxShadow: [
              BoxShadow(
                color: const Color(0xFF7845FF).withValues(alpha: .38),
                blurRadius: 12,
              ),
              BoxShadow(
                color: const Color(0xFF43D8FF).withValues(alpha: .14),
                blurRadius: 16,
              ),
            ],
          ),
          child: Container(
            clipBehavior: Clip.antiAlias,
            decoration: const BoxDecoration(
              shape: BoxShape.circle,
              color: Color(0xFF59388A),
            ),
            child: photoUrl.isNotEmpty
                ? Image.network(
                    photoUrl,
                    width: 30,
                    height: 30,
                    fit: BoxFit.cover,
                    errorBuilder: (context, error, stackTrace) {
                      return _fallbackAvatar();
                    },
                  )
                : _fallbackAvatar(),
          ),
        );
      },
    );
  }
}

