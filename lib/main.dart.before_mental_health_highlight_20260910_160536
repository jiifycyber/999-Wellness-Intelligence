  String _providerDayName(int value) {
    switch (value) {
      case 1:
        return 'Monday';
      case 2:
        return 'Tuesday';
      case 3:
        return 'Wednesday';
      case 4:
        return 'Thursday';
      case 5:
        return 'Friday';
      case 6:
        return 'Saturday';
      case 7:
        return 'Sunday';
      default:
        return 'Day';
    }
  }

  String _cleanProviderTime(dynamic value) {
    final raw = value?.toString() ?? '';

    if (raw.length >= 5) {
      return raw.substring(0, 5);
    }

    return raw;
  }

  Future<void> _saveWeeklyAvailabilityRow(
    Map<String, dynamic> row, {
    required bool enabled,
    required String startTime,
    required String endTime,
  }) async {
    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) {
      return;
    }

    final day = int.tryParse(row['day_of_week']?.toString() ?? '');

    if (day == null) {
      return;
    }

    await Supabase.instance.client.from('provider_weekly_availability').upsert({
      'provider_id': user.id,
      'day_of_week': day,
      'enabled': enabled,
      'start_time': startTime,
      'end_time': endTime,
      'updated_at': DateTime.now().toIso8601String(),
    }, onConflict: 'provider_id,day_of_week');
  }

  Future<void> _openWeeklyAvailabilityEditor({
