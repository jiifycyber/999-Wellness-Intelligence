    }

    if (_weeklyAvailability.isEmpty) {
      await _loadScheduleData();
    }

    if (!mounted) {
      return;
    }

    final rows =
        _weeklyAvailability
            .map((row) => Map<String, dynamic>.from(row))
            .toList()
          ..sort((a, b) {
            final aDay = int.tryParse(a['day_of_week']?.toString() ?? '') ?? 0;
            final bDay = int.tryParse(b['day_of_week']?.toString() ?? '') ?? 0;
            return aDay.compareTo(bDay);
          });

    String displayTime(dynamic value) {
      final raw = _cleanProviderTime(value).trim();

      final parts = raw.split(':');

      if (parts.length < 2) {
        return raw;
      }

      final hour = int.tryParse(parts[0]);
      final minute = int.tryParse(parts[1]);

      if (hour == null || minute == null) {
        return raw;
      }

      final suffix = hour >= 12 ? 'PM' : 'AM';
      final displayHour = hour == 0
          ? 12
          : hour > 12
          ? hour - 12
          : hour;

      return '${displayHour.toString().padLeft(2, '0')}:'
          '${minute.toString().padLeft(2, '0')} $suffix';
    }

    TimeOfDay parseTime(dynamic value) {
      final raw = _cleanProviderTime(value).trim();
      final parts = raw.split(':');

      if (parts.length >= 2) {
        final hour = int.tryParse(parts[0]) ?? 9;
        final minute = int.tryParse(parts[1]) ?? 0;

        return TimeOfDay(hour: hour.clamp(0, 23), minute: minute.clamp(0, 59));
      }

      return const TimeOfDay(hour: 9, minute: 0);
