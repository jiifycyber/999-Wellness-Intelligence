class _ProviderCommandCenterScreenState
    extends State<ProviderCommandCenterScreen> {
  bool _availableNow = true;
  int _selectedIndex = 0;

  bool _providerPulseLoading = true;
  int _liveBookingRequests = 0;
  int _liveTodayBookings = 0;
  double _liveWeeklyEarnings = 0;
  double _liveProviderRating = 0;
  int _liveProviderReviewCount = 0;
  int _liveUnreadMessages = 0;
  String _liveProviderPhotoUrl = '';
  List<Map<String, dynamic>> _liveProviderBookings = [];

  @override
  void initState() {
    super.initState();
    _loadProviderCommandCenterData();
  }

  bool _isTodayProviderValue(dynamic value) {
    final raw = value?.toString().trim() ?? '';

    if (raw.isEmpty) {
      return false;
    }

    final now = DateTime.now();
    final isoDay =
        '${now.year.toString().padLeft(4, '0')}-'
        '${now.month.toString().padLeft(2, '0')}-'
        '${now.day.toString().padLeft(2, '0')}';

    if (raw.startsWith(isoDay) || raw.contains(isoDay)) {
      return true;
    }

    final parsed = DateTime.tryParse(raw);

    if (parsed == null) {
      return false;
    }

    final local = parsed.toLocal();

    return local.year == now.year &&
        local.month == now.month &&
        local.day == now.day;
  }

  DateTime? _providerBookingDate(Map<String, dynamic> booking) {
    const keys = [
      'completed_at',
      'paid_at',
      'updated_at',
      'created_at',
      'booking_day',
    ];

    for (final key in keys) {
      final raw = booking[key]?.toString().trim() ?? '';

      if (raw.isEmpty) {
        continue;
      }

      final parsed = DateTime.tryParse(raw);

      if (parsed != null) {
        return parsed.toLocal();
      }
    }

    return null;
  }

  double _providerBookingAmount(Map<String, dynamic> booking) {
    const keys = [
      'provider_amount',
      'provider_earnings',
      'net_amount',
      'amount',
      'total_amount',
      'price',
    ];

    for (final key in keys) {
      final value = booking[key];

      if (value is num) {
        return value.toDouble();
      }

      final parsed = double.tryParse(
        value?.toString().replaceAll(r'$', '').replaceAll(',', '').trim() ?? '',
      );

      if (parsed != null) {
        return parsed;
      }
    }

    return 0;
  }

  String _providerMoney(double amount) {
    final rounded = amount.round();

    String digits = rounded.abs().toString();
    final parts = <String>[];

    while (digits.length > 3) {
      parts.insert(0, digits.substring(digits.length - 3));
      digits = digits.substring(0, digits.length - 3);
    }

    parts.insert(0, digits);

    return '${rounded < 0 ? '-' : ''}\$${parts.join(',')}';
  }

  double _providerRatingFromProfile(Map<String, dynamic> profile) {
    const keys = ['average_rating', 'rating', 'provider_rating', 'avg_rating'];

    for (final key in keys) {
      final value = profile[key];

      if (value is num) {
        return value.toDouble();
      }

      final parsed = double.tryParse(value?.toString() ?? '');

      if (parsed != null) {
        return parsed;
      }
    }

    return 0;
  }

  int _providerReviewCountFromProfile(Map<String, dynamic> profile) {
    const keys = [
      'review_count',
      'rating_count',
      'reviews_count',
      'total_reviews',
    ];

    for (final key in keys) {
      final value = profile[key];

      if (value is num) {
        return value.toInt();
      }

      final parsed = int.tryParse(value?.toString() ?? '');

      if (parsed != null) {
        return parsed;
      }
    }

    return 0;
  }

  Future<void> _loadProviderCommandCenterData() async {
    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) {
      if (mounted) {
        setState(() {
          _providerPulseLoading = false;
        });
      }

      return;
    }

    try {
      final bookingRaw = await Supabase.instance.client
          .from('bookings')
          .select()
          .eq('provider_id', user.id);

      final bookings = (bookingRaw as List)
          .map((row) => Map<String, dynamic>.from(row as Map))
          .toList();

      int unreadMessages = 0;

      try {
        final messageRaw = await Supabase.instance.client
            .from('messages')
            .select('id, read_at')
            .eq('receiver_id', user.id);

        unreadMessages = (messageRaw as List).where((row) {
          final message = Map<String, dynamic>.from(row as Map);
          return message['read_at'] == null;
        }).length;
      } catch (_) {}

      Map<String, dynamic> provider = <String, dynamic>{};

      try {
        final providerRaw = await Supabase.instance.client
            .from('provider_profiles')
            .select()
            .eq('id', user.id)
            .maybeSingle();

        if (providerRaw != null) {
          provider = Map<String, dynamic>.from(providerRaw);
        }
      } catch (_) {}

      final now = DateTime.now();

      final startOfWeek = DateTime(
        now.year,
        now.month,
        now.day,
      ).subtract(Duration(days: now.weekday - 1));

      final endOfWeek = startOfWeek.add(const Duration(days: 7));

      int requests = 0;
      int today = 0;
      double weekly = 0;

      for (final booking in bookings) {
        final status = booking['status']?.toString().trim().toLowerCase() ?? '';

        final paymentStatus =
            booking['payment_status']?.toString().trim().toLowerCase() ?? '';

        if (status == 'requested') {
          requests++;
        }

        if (status != 'cancelled' &&
            _isTodayProviderValue(booking['booking_day'])) {
          today++;
        }

        final bookingDate = _providerBookingDate(booking);

        final paid =
            paymentStatus == 'paid' ||
            paymentStatus == 'succeeded' ||
            paymentStatus == 'complete' ||
            paymentStatus == 'completed';

        if (paid &&
            bookingDate != null &&
            !bookingDate.isBefore(startOfWeek) &&
            bookingDate.isBefore(endOfWeek)) {
          weekly += _providerBookingAmount(booking);
        }
      }

      if (!mounted) {
        return;
      }

      setState(() {
        _liveBookingRequests = requests;
        _liveTodayBookings = today;
        _liveWeeklyEarnings = weekly;
        _liveProviderRating = _providerRatingFromProfile(provider);
        _liveProviderReviewCount = _providerReviewCountFromProfile(provider);
        _liveUnreadMessages = unreadMessages;
        _liveProviderPhotoUrl =
            provider['profile_photo_url']?.toString().trim() ?? '';
        _liveProviderBookings = bookings;
        _availableNow = provider['available_now'] != false;
        _providerPulseLoading = false;
      });
    } catch (error) {
      if (!mounted) {
        return;
      }

      setState(() {
        _providerPulseLoading = false;
      });

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          behavior: SnackBarBehavior.floating,
          content: Text('Unable to load provider dashboard: $error'),
        ),
      );
    }
  }

  Future<void> _setProviderCommandAvailability(bool value) async {
    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) {
      return;
    }

    final previous = _availableNow;

    setState(() {
      _availableNow = value;
    });

    try {
      await Supabase.instance.client
          .from('provider_profiles')
          .update({
            'available_now': value,
            'updated_at': DateTime.now().toIso8601String(),
          })
          .eq('id', user.id);
    } catch (error) {
      if (!mounted) {
        return;
      }

      setState(() {
        _availableNow = previous;
      });

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          behavior: SnackBarBehavior.floating,
          content: Text('Unable to update availability: $error'),
        ),
      );
    }
  }

