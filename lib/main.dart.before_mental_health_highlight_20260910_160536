  const _CustomerAiSmartMatchScreen();

  @override
  State<_CustomerAiSmartMatchScreen> createState() =>
      _CustomerAiSmartMatchScreenState();
}

class _CustomerAiSmartMatchScreenState
    extends State<_CustomerAiSmartMatchScreen> {
  String _service = 'Massage';
  String _location = 'Mobile or Studio';
  String _gender = 'No Preference';
  String _availability = 'Today';

  bool _generated = false;
  bool _providersLoading = false;
  String? _providersError;
  List<Map<String, dynamic>> _providers = [];

  String _aiConciergeQuery = '';
  bool _aiConciergeInterpreting = false;

  Future<void> _loadLiveProviders() async {
    if (_providersLoading) return;

    setState(() {
      _providersLoading = true;
      _providersError = null;
    });

    try {
      final profileData = await Supabase.instance.client
          .from('provider_profiles')
          .select(
            'id, full_name, professional_name, business_name, bio, '
            'service_area, available_now, rating, review_count, profile_photo_url',
          )
          .order('professional_name');

      final serviceData = await Supabase.instance.client
          .from('provider_services')
          .select('provider_id, service_name, specialty, price, active')
          .eq('active', true);

      final profiles = (profileData as List)
          .map((row) => Map<String, dynamic>.from(row as Map))
          .toList();

      final services = (serviceData as List)
          .map((row) => Map<String, dynamic>.from(row as Map))
          .toList();

      final liveProviders = <Map<String, dynamic>>[];

      for (final profile in profiles) {
        final providerId = profile['id']?.toString() ?? '';

        final name =
            (profile['professional_name']?.toString().trim().isNotEmpty ??
                false)
            ? profile['professional_name'].toString().trim()
            : (profile['full_name']?.toString().trim().isNotEmpty ?? false)
            ? profile['full_name'].toString().trim()
            : 'Wellness Provider';

        final providerServices = services
            .where(
              (service) => service['provider_id']?.toString() == providerId,
            )
            .toList();

        final serviceNames = providerServices
            .map((service) => service['service_name']?.toString() ?? '')
            .where((service) => service.trim().isNotEmpty)
            .toList();

        final selectedService = _service.trim().toLowerCase();

        final serviceMatch =
            selectedService.isEmpty ||
            providerServices.any((service) {
              final serviceName =
                  service['service_name']?.toString().toLowerCase() ?? '';
              final specialty =
                  service['specialty']?.toString().toLowerCase() ?? '';

              return serviceName.contains(selectedService) ||
                  specialty.contains(selectedService);
            });

        if (!serviceMatch && providerServices.isNotEmpty) {
          continue;
        }

        if (_availability == 'Available Now' &&
            profile['available_now'] != true) {
          continue;
        }

        final businessName = profile['business_name']?.toString().trim();
        final rating =
            double.tryParse(profile['rating']?.toString() ?? '') ?? 0;

        final reasonParts = <String>[
          'Live provider from the 999 Wellness Intelligence network.',
        ];

        if (serviceNames.isNotEmpty) {
          reasonParts.add('Services: ${serviceNames.join(', ')}.');
        }

        if (profile['available_now'] == true) {
          reasonParts.add('Available now.');
        }

        liveProviders.add({
          'id': providerId,
          'name': name,
          'title': businessName != null && businessName.isNotEmpty
              ? businessName
              : 'Wellness Provider',
          'rating': rating > 0 ? rating.toStringAsFixed(1) : 'NEW',
          'profile_photo_url': profile['profile_photo_url']?.toString() ?? '',
          'match': 'LIVE',
          'reason': reasonParts.join(' '),
          'color': const Color(0xFF5EDCFF),
        });
      }

      if (!mounted) return;

      setState(() {
        _providers = liveProviders;
        _providersLoading = false;
      });
    } catch (error) {
      if (!mounted) return;

      setState(() {
        _providers = [];
        _providersLoading = false;
        _providersError = error.toString();
      });
    }
  }

  Future<void> _generateMatches() async {
    await _loadLiveProviders();

    if (!mounted) return;

    setState(() {
      _generated = true;
    });
  }

  Future<void> _applyAiConciergeQuery(String input) async {
    final query = input.trim().toLowerCase();

    if (query.isEmpty || _aiConciergeInterpreting) {
      return;
    }

    setState(() {
      _aiConciergeQuery = input.trim();
      _aiConciergeInterpreting = true;
      _generated = false;
    });

    String nextService = _service;
    String nextLocation = _location;
    String nextGender = _gender;
    String nextAvailability = _availability;

    if (query.contains('deep tissue') ||
        query.contains('massage') ||
        query.contains('massager')) {
      nextService = 'Massage';
    } else if (query.contains('facial')) {
      nextService = 'Facial';
    } else if (query.contains('recovery')) {
      nextService = 'Recovery';
    } else if (query.contains('holistic')) {
      nextService = 'Holistic Wellness';
    }

    if (query.contains('mobile') ||
        query.contains('come to me') ||
        query.contains('my home') ||
        query.contains('my house')) {
      nextLocation = 'Mobile';
    } else if (query.contains('studio')) {
      nextLocation = 'Studio';
    }

    if (query.contains('available now') ||
        query.contains('right now') ||
        query.contains('asap') ||
        query.contains('immediately')) {
      nextAvailability = 'Available Now';
    } else if (query.contains('tomorrow')) {
      nextAvailability = 'Tomorrow';
    } else if (query.contains('this week') || query.contains('weekend')) {
      nextAvailability = 'This Week';
    } else if (query.contains('today') ||
        query.contains('tonight') ||
        query.contains('this evening')) {
      nextAvailability = 'Today';
    }

    if (query.contains('no preference')) {
      nextGender = 'No Preference';
    } else if (query.contains('trans woman')) {
      nextGender = 'Trans Woman';
    } else if (query.contains('trans man')) {
      nextGender = 'Trans Man';
    } else if (query.contains('nonbinary')) {
      nextGender = 'Nonbinary';
    } else if (query.contains('genderfluid')) {
      nextGender = 'Genderfluid';
    } else if (query.contains('genderqueer')) {
      nextGender = 'Genderqueer';
    } else if (query.contains('agender')) {
      nextGender = 'Agender';
    } else if (query.contains('woman provider') ||
        query.contains('female provider') ||
        query.contains('woman therapist') ||
        query.contains('female therapist')) {
      nextGender = 'Woman';
    } else if (query.contains('man provider') ||
        query.contains('male provider') ||
        query.contains('man therapist') ||
        query.contains('male therapist')) {
      nextGender = 'Man';
    }

    if (!mounted) {
      return;
    }

    setState(() {
      _service = nextService;
      _location = nextLocation;
      _gender = nextGender;
      _availability = nextAvailability;
    });

    await Future<void>.delayed(const Duration(milliseconds: 350));

    if (!mounted) {
      return;
    }

    setState(() {
      _aiConciergeInterpreting = false;
    });

    await _generateMatches();
  }

