  Future<void> _loadScheduleData() async {
    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) {
      return;
    }

    if (mounted) {
      setState(() {
        _scheduleLoading = true;
      });
    }

    try {
      final profile = await Supabase.instance.client
          .from('provider_profiles')
          .select('available_now')
          .eq('id', user.id)
          .maybeSingle();

      final weeklyRaw = await Supabase.instance.client
          .from('provider_weekly_availability')
          .select(
            'id, provider_id, day_of_week, enabled, start_time, end_time, updated_at',
          )
          .eq('provider_id', user.id)
          .order('day_of_week');

      final blockedRaw = await Supabase.instance.client
          .from('provider_blocked_times')
          .select(
            'id, provider_id, start_at, end_at, reason, created_at, updated_at',
          )
          .eq('provider_id', user.id)
          .order('start_at');

      if (!mounted) {
        return;
      }

      setState(() {
        _availableNow = profile?['available_now'] == true;

        _weeklyAvailability = (weeklyRaw as List)
            .map((row) => Map<String, dynamic>.from(row as Map))
            .toList();

        _blockedTimes = (blockedRaw as List)
            .map((row) => Map<String, dynamic>.from(row as Map))
            .toList();

        _scheduleLoading = false;
      });
    } catch (error) {
      if (!mounted) {
        return;
      }

      setState(() {
        _scheduleLoading = false;
      });

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          behavior: SnackBarBehavior.floating,
          content: Text('Unable to load schedule: $error'),
        ),
      );
    }
  }

  Future<void> _setProviderAvailableNow(bool value) async {
    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) {
      return;
    }

    final previous = _availableNow;

    setState(() {
      _availableNow = value;
    });

    try {
      await Supabase.instance.client
          .from('provider_profiles')
          .update({'available_now': value})
          .eq('id', user.id);

      if (!mounted) {
        return;
      }

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          behavior: SnackBarBehavior.floating,
          content: Text(
            value
                ? 'You are now visible as available.'
                : 'Available Now has been turned off.',
          ),
        ),
      );
    } catch (error) {
      if (!mounted) {
        return;
      }

      setState(() {
        _availableNow = previous;
      });

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          behavior: SnackBarBehavior.floating,
          content: Text('Unable to update availability: $error'),
        ),
      );
    }
