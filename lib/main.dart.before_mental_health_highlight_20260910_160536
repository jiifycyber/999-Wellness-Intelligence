class _ProviderMarketplaceScreenState
    extends State<_ProviderMarketplaceScreen> {
  late final TextEditingController _searchController;

  String _query = '';
  String _category = 'All';

  final Set<String> _favorites = {};

  List<Map<String, dynamic>> _providers = [];
  bool _providersLoading = true;
  String? _providersError;

  @override
  void initState() {
    super.initState();

    _query = widget.initialQuery;
    _searchController = TextEditingController(text: widget.initialQuery);

    _loadLiveProviders();
    _loadFavorites();
  }

  Future<void> _loadFavorites() async {
    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) {
      if (!mounted) return;

      setState(() {
        _favorites.clear();
      });
      return;
    }

    try {
      final rows = await Supabase.instance.client
          .from('customer_favorites')
          .select('provider_id')
          .eq('customer_id', user.id);

      final ids = (rows as List)
          .map((row) => Map<String, dynamic>.from(row as Map))
          .map((row) => row['provider_id']?.toString() ?? '')
          .where((id) => id.isNotEmpty)
          .toSet();

      if (!mounted) return;

      setState(() {
        _favorites
          ..clear()
          ..addAll(ids);
      });
    } catch (error) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Unable to load saved providers.')),
      );
    }
  }

  Future<void> _toggleFavorite(Map<String, dynamic> provider) async {
    final user = Supabase.instance.client.auth.currentUser;
    final providerId = provider['id']?.toString() ?? '';

    if (user == null || providerId.isEmpty) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Unable to update this favorite.')),
      );
      return;
    }

    final wasFavorite = _favorites.contains(providerId);

    try {
      if (wasFavorite) {
        await Supabase.instance.client
            .from('customer_favorites')
            .delete()
            .eq('customer_id', user.id)
            .eq('provider_id', providerId);
      } else {
        await Supabase.instance.client.from('customer_favorites').insert({
          'customer_id': user.id,
          'provider_id': providerId,
        });
      }

      if (!mounted) return;

      setState(() {
        if (wasFavorite) {
          _favorites.remove(providerId);
        } else {
          _favorites.add(providerId);
        }
      });
    } catch (error) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            wasFavorite
                ? 'Could not remove this saved provider.'
                : 'Could not save this provider.',
          ),
        ),
      );
    }
  }

  String _providerInitials(String name) {
    final parts = name
        .trim()
        .split(RegExp(r'\\s+'))
        .where((part) => part.isNotEmpty)
        .toList();

    if (parts.isEmpty) return 'WP';

    if (parts.length == 1) {
      final word = parts.first.toUpperCase();
      return word.length >= 2 ? word.substring(0, 2) : word;
    }

    return '${parts.first[0]}${parts.last[0]}'.toUpperCase();
  }

  Future<void> _loadLiveProviders() async {
    if (mounted) {
      setState(() {
        _providersLoading = true;
        _providersError = null;
      });
    }

    try {
      final profileData = await Supabase.instance.client
          .from('provider_profiles')
          .select(
            'id, full_name, professional_name, business_name, bio, '
            'service_area, available_now, profile_photo_url, rating, review_count',
          )
          .order('professional_name');

      final serviceData = await Supabase.instance.client
          .from('provider_services')
          .select('provider_id, service_name, specialty, price, active')
          .eq('active', true);

      final profiles = (profileData as List)
          .map((row) => Map<String, dynamic>.from(row as Map))
          .toList();

      final services = (serviceData as List)
          .map((row) => Map<String, dynamic>.from(row as Map))
          .toList();

      final mappedProviders = <Map<String, dynamic>>[];

      for (final profile in profiles) {
        final providerId = profile['id']?.toString() ?? '';

        final name =
            (profile['professional_name']?.toString().trim().isNotEmpty ??
                false)
            ? profile['professional_name'].toString().trim()
            : (profile['full_name']?.toString().trim().isNotEmpty ?? false)
            ? profile['full_name'].toString().trim()
            : 'Wellness Provider';

        final providerServices = services
            .where(
              (service) => service['provider_id']?.toString() == providerId,
            )
            .toList();

        final serviceNames = providerServices
            .map((service) => service['service_name']?.toString() ?? '')
            .where((service) => service.trim().isNotEmpty)
            .toList();

        final prices = providerServices
            .map((service) => service['price'])
            .where((price) => price != null)
            .map((price) => double.tryParse(price.toString()))
            .whereType<double>()
            .toList();

        final specialty = providerServices.isNotEmpty
            ? providerServices.first['specialty']?.toString()
            : null;

        final businessName = profile['business_name']?.toString().trim();
        final serviceArea = profile['service_area']?.toString().trim();
        final availableNow = profile['available_now'] == true;

        final ratingValue =
            double.tryParse(profile['rating']?.toString() ?? '') ?? 0;

        final reviewCount =
            int.tryParse(profile['review_count']?.toString() ?? '') ?? 0;

        mappedProviders.add({
          'id': providerId,
          'name': name,
          'initials': _providerInitials(name),
          'title': businessName != null && businessName.isNotEmpty
              ? businessName
              : 'Wellness Provider',
          'rating': ratingValue > 0 ? ratingValue.toStringAsFixed(1) : 'NEW',
          'reviews': reviewCount.toString(),
          'distance': serviceArea != null && serviceArea.isNotEmpty
              ? serviceArea
              : 'Service Area Updating',
          'price': prices.isNotEmpty
              ? '\$${prices.reduce((a, b) => a < b ? a : b).toStringAsFixed(0)}+'
              : 'Rates',
          'type': 'Mobile',
          'category': specialty != null && specialty.trim().isNotEmpty
              ? specialty
              : 'Massage',
          'badge': availableNow ? 'AVAILABLE NOW' : 'VERIFIED',
          'services': serviceNames.isNotEmpty
              ? serviceNames
              : <String>['Wellness Services'],
          'profile_photo_url': profile['profile_photo_url'],
        });
      }

      if (!mounted) return;

      setState(() {
        _providers = mappedProviders;
        _providersLoading = false;
      });
    } catch (error) {
      if (!mounted) return;

      setState(() {
        _providersError = error.toString();
        _providersLoading = false;
      });
    }
  }

  @override
  void dispose() {
    _searchController.dispose();
    super.dispose();
  }

  List<Map<String, dynamic>> get _visibleProviders {
    return _providers.where((provider) {
      final q = _query.trim().toLowerCase();

      final services = (provider['services'] as List<dynamic>)
          .join(' ')
          .toLowerCase();

      final matchesText =
          q.isEmpty ||
          provider['name'].toString().toLowerCase().contains(q) ||
          provider['title'].toString().toLowerCase().contains(q) ||
          services.contains(q);

      final matchesCategory =
          _category == 'All' || provider['category'] == _category;

      return matchesText && matchesCategory;
    }).toList();
  }

