  bool _commandQueueBookingVisible(Map<String, dynamic> booking) {
    final status = booking['status']?.toString().trim().toLowerCase() ?? '';

    if (status == 'cancelled' || status == 'completed') {
      return false;
    }

    if (status == 'requested') {
      return true;
    }

    return _isTodayProviderValue(booking['booking_day']);
  }

  List<Map<String, dynamic>> _liveCommandQueue() {
    final rows = _liveProviderBookings
        .where(_commandQueueBookingVisible)
        .map((row) => Map<String, dynamic>.from(row))
        .toList();

    rows.sort((a, b) {
      final aRequested =
          a['status']?.toString().trim().toLowerCase() == 'requested';

      final bRequested =
          b['status']?.toString().trim().toLowerCase() == 'requested';

      if (aRequested != bRequested) {
        return aRequested ? -1 : 1;
      }

      final aDay = a['booking_day']?.toString() ?? '';
      final bDay = b['booking_day']?.toString() ?? '';

      final dayResult = aDay.compareTo(bDay);

      if (dayResult != 0) {
        return dayResult;
      }

      final aTime = a['booking_time']?.toString() ?? '';
      final bTime = b['booking_time']?.toString() ?? '';

      return aTime.compareTo(bTime);
    });

    return rows.take(5).toList();
  }

  String _commandQueueTime(Map<String, dynamic> booking) {
    final raw = booking['booking_time']?.toString().trim() ?? '';

    if (raw.isEmpty) {
      return 'Time pending';
    }

    final match = RegExp(r'^(\d{1,2}):(\d{2})').firstMatch(raw);

    if (match == null) {
      return raw;
    }

    final hour24 = int.tryParse(match.group(1) ?? '');
    final minute = match.group(2) ?? '00';

    if (hour24 == null) {
      return raw;
    }

    final hour = hour24 == 0
        ? 12
        : hour24 > 12
        ? hour24 - 12
        : hour24;

    final suffix = hour24 >= 12 ? 'PM' : 'AM';

    return '$hour:$minute $suffix';
  }

  String _commandQueueTitle(Map<String, dynamic> booking) {
    final status = booking['status']?.toString().trim().toLowerCase() ?? '';

    final type = booking['service_type']?.toString().trim().toLowerCase() ?? '';

    if (status == 'requested') {
      return 'New Booking Request';
    }

    if (status == 'en route') {
      return 'Provider En Route';
    }

    if (status == 'arrived') {
      return 'Arrival Confirmed';
    }

    if (status == 'in session') {
      return 'Session In Progress';
    }

    if (type.contains('mobile')) {
      return 'Mobile Appointment';
    }

    return 'Upcoming Appointment';
  }

  IconData _commandQueueIcon(Map<String, dynamic> booking) {
    final status = booking['status']?.toString().trim().toLowerCase() ?? '';

    if (status == 'requested') {
      return Icons.notifications_active_outlined;
    }

    if (status == 'en route') {
      return Icons.directions_car_filled_outlined;
    }

    if (status == 'arrived') {
      return Icons.location_on_outlined;
    }

    if (status == 'in session') {
      return Icons.spa_outlined;
    }

    return Icons.event_available_rounded;
  }

  Color _commandQueueColor(Map<String, dynamic> booking) {
    final status = booking['status']?.toString().trim().toLowerCase() ?? '';

    switch (status) {
      case 'requested':
        return const Color(0xFFFFB05A);
      case 'accepted':
        return const Color(0xFF47D5FF);
      case 'en route':
        return const Color(0xFF9A6AFF);
      case 'arrived':
        return const Color(0xFFD667FF);
      case 'in session':
        return const Color(0xFFFF7CC8);
      default:
        return const Color(0xFF8D7CFF);
    }
  }

