  Future<void> _loadProviderEarnings() async {
    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) {
      return;
    }

    if (mounted) {
      setState(() {
        _earningsLoading = true;
      });
    }

    try {
      final raw = await Supabase.instance.client
          .from('bookings')
          .select(
            'id, provider_id, provider_name, customer_name, service_name, '
            'price, status, payment_status, payment_completed_at, '
            'stripe_payment_intent_id, stripe_charge_id, stripe_transfer_id, '
            'booking_day, booking_time, created_at',
          )
          .eq('provider_id', user.id)
          .eq('payment_status', 'Paid')
          .order('payment_completed_at', ascending: false);

      if (!mounted) {
        return;
      }

      setState(() {
        _paidProviderBookings = (raw as List)
            .map((row) => Map<String, dynamic>.from(row as Map))
            .toList();

        _earningsLoading = false;
      });
    } catch (error) {
      if (!mounted) {
        return;
      }

      setState(() {
        _earningsLoading = false;
      });

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          behavior: SnackBarBehavior.floating,
