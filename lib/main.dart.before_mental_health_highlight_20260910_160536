class _999AiHudBackgroundPainter extends CustomPainter {
  const _999AiHudBackgroundPainter({required this.progress});

  final double progress;

  @override
  void paint(Canvas canvas, Size size) {
    final gridPaint = Paint()
      ..color = const Color(0xFF6D87C7).withValues(alpha: .075)
      ..strokeWidth = 1;

    const spacing = 34.0;

    final xOffset = (progress * spacing) % spacing;
    final yOffset = (progress * spacing * .7) % spacing;

    for (
      double x = -spacing + xOffset;
      x < size.width + spacing;
      x += spacing
    ) {
      canvas.drawLine(Offset(x, 0), Offset(x, size.height), gridPaint);
    }

    for (
      double y = -spacing + yOffset;
      y < size.height + spacing;
      y += spacing
    ) {
      canvas.drawLine(Offset(0, y), Offset(size.width, y), gridPaint);
    }

    final circuitPaint = Paint()
      ..color = const Color(0xFF7C69FF).withValues(alpha: .12)
      ..strokeWidth = 1.2
      ..style = PaintingStyle.stroke;

    final pathA = Path()
      ..moveTo(size.width * .03, size.height * .18)
      ..lineTo(size.width * .17, size.height * .18)
      ..lineTo(size.width * .22, size.height * .29)
      ..lineTo(size.width * .34, size.height * .29);

    canvas.drawPath(pathA, circuitPaint);

    final pathB = Path()
      ..moveTo(size.width * .69, size.height * .73)
      ..lineTo(size.width * .82, size.height * .73)
      ..lineTo(size.width * .87, size.height * .61)
      ..lineTo(size.width * .97, size.height * .61);

    canvas.drawPath(pathB, circuitPaint);

    final nodePaint = Paint()
      ..color = const Color(0xFF69DFFF).withValues(alpha: .52);

    canvas.drawCircle(
      Offset(size.width * .17, size.height * .18),
      2.4,
      nodePaint,
    );

    canvas.drawCircle(
      Offset(size.width * .87, size.height * .61),
      2.4,
      nodePaint,
    );

    final beamX = size.width * progress;

    final beamPaint = Paint()
      ..shader = LinearGradient(
        colors: [
          Colors.transparent,
          const Color(0xFF4DDFFF).withValues(alpha: .02),
          const Color(0xFF8C65FF).withValues(alpha: .10),
          const Color(0xFF4DDFFF).withValues(alpha: .02),
          Colors.transparent,
        ],
      ).createShader(Rect.fromLTWH(beamX - 80, 0, 160, size.height));

    canvas.drawRect(Rect.fromLTWH(beamX - 80, 0, 160, size.height), beamPaint);
  }

  @override
  bool shouldRepaint(covariant _999AiHudBackgroundPainter oldDelegate) {
    return oldDelegate.progress != progress;
  }
}

class _999NeuralCorePainter extends CustomPainter {
  const _999NeuralCorePainter({required this.progress});

  final double progress;

  @override
  void paint(Canvas canvas, Size size) {
    final center = Offset(size.width / 2, size.height / 2);

    final shortest = size.shortestSide;
    const twoPi = 6.283185307179586;

    final aura = Paint()
      ..color = const Color(0xFF704CFF).withValues(alpha: .16)
      ..style = PaintingStyle.stroke
      ..strokeWidth = shortest * .10;

    canvas.drawCircle(center, shortest * .30, aura);

    final orbitPurple = Paint()
      ..color = const Color(0xFF9E72FF).withValues(alpha: .78)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1.5;

    final orbitCyan = Paint()
      ..color = const Color(0xFF52DFFF).withValues(alpha: .72)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1.2;

    canvas.save();
    canvas.translate(center.dx, center.dy);
    canvas.rotate(progress * twoPi);
    canvas.scale(1.0, .47);
    canvas.drawCircle(Offset.zero, shortest * .40, orbitPurple);
    canvas.restore();

    canvas.save();
    canvas.translate(center.dx, center.dy);
    canvas.rotate(-progress * twoPi * .74);
    canvas.scale(.55, 1.0);
    canvas.drawCircle(Offset.zero, shortest * .39, orbitCyan);
    canvas.restore();

    canvas.save();
    canvas.translate(center.dx, center.dy);
    canvas.rotate(progress * twoPi * .46);
    canvas.scale(1.0, .72);
    canvas.drawCircle(
      Offset.zero,
      shortest * .47,
      Paint()
        ..color = const Color(0xFF6375FF).withValues(alpha: .33)
        ..style = PaintingStyle.stroke
        ..strokeWidth = 1,
    );
    canvas.restore();

    final nodePaint = Paint()..color = const Color(0xFFDCCFFF);

    for (int i = 0; i < 10; i++) {
      final angle = ((i / 10) * twoPi) + (progress * twoPi);

      final radius = shortest * .42;

      final point = Offset(
        center.dx + radius * _999FastMath.cos(angle),
        center.dy + radius * _999FastMath.sin(angle),
      );

      canvas.drawCircle(point, i.isEven ? 2.8 : 1.7, nodePaint);
    }

    final sweepAngle = progress * twoPi;

    final sweepPaint = Paint()
      ..color = const Color(0xFF6BE7FF).withValues(alpha: .30)
      ..strokeWidth = 1;

    canvas.drawLine(
      center,
      Offset(
        center.dx + shortest * .44 * _999FastMath.cos(sweepAngle),
        center.dy + shortest * .44 * _999FastMath.sin(sweepAngle),
      ),
      sweepPaint,
    );
  }

  @override
  bool shouldRepaint(covariant _999NeuralCorePainter oldDelegate) {
    return oldDelegate.progress != progress;
  }
}

class _999FastMath {
  static double sin(double x) {
    const pi = 3.141592653589793;
    const twoPi = pi * 2;

    x %= twoPi;

    if (x > pi) {
      x -= twoPi;
    }

    if (x < -pi) {
      x += twoPi;
    }

    final x2 = x * x;

    return x *
        (1 -
            x2 / 6 +
            x2 * x2 / 120 -
            x2 * x2 * x2 / 5040 +
            x2 * x2 * x2 * x2 / 362880);
  }

  static double cos(double x) {
    return sin(x + 1.5707963267948966);
  }
}

