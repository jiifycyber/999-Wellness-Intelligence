class _CustomerSavedProvidersScreenState
    extends State<_CustomerSavedProvidersScreen> {
  final List<String> _saved = [];
  final Map<String, String> _savedIds = {};
  final Map<String, String> _savedPhotos = {};
  bool _loading = true;

  @override
  void initState() {
    super.initState();
    _loadSavedProviders();
  }

  Future<void> _loadSavedProviders() async {
    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) {
      if (!mounted) return;
      setState(() {
        _saved.clear();
        _savedIds.clear();
        _savedPhotos.clear();
        _loading = false;
      });
      return;
    }

    try {
      final favoriteRows = await Supabase.instance.client
          .from('customer_favorites')
          .select('provider_id')
          .eq('customer_id', user.id);

      final ids = (favoriteRows as List)
          .map((row) => Map<String, dynamic>.from(row as Map))
          .map((row) => row['provider_id']?.toString() ?? '')
          .where((id) => id.isNotEmpty)
          .toSet();

      if (ids.isEmpty) {
        if (!mounted) return;
        setState(() {
          _saved.clear();
          _savedIds.clear();
          _loading = false;
        });
        return;
      }

      final profileRows = await Supabase.instance.client
          .from('provider_profiles')
          .select('id, full_name, professional_name, profile_photo_url');

      final names = <String>[];
      final nameIds = <String, String>{};
      final namePhotos = <String, String>{};

      for (final row in (profileRows as List)) {
        final provider = Map<String, dynamic>.from(row as Map);
        final id = provider['id']?.toString() ?? '';
        if (!ids.contains(id)) continue;

        final professionalName =
            provider['professional_name']?.toString().trim() ?? '';
        final fullName = provider['full_name']?.toString().trim() ?? '';
        final name = professionalName.isNotEmpty
            ? professionalName
            : fullName.isNotEmpty
            ? fullName
            : 'Wellness Provider';

        names.add(name);
        nameIds[name] = id;
        namePhotos[name] = provider['profile_photo_url']?.toString() ?? '';
      }

      if (!mounted) return;
      setState(() {
        _saved
          ..clear()
          ..addAll(names);
        _savedIds
          ..clear()
          ..addAll(nameIds);
        _savedPhotos
          ..clear()
          ..addAll(namePhotos);
        _loading = false;
      });
    } catch (error) {
      if (!mounted) return;
      setState(() {
        _loading = false;
      });
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Unable to load saved providers.')),
      );
    }
  }

  Future<void> _removeFavorite(String provider) async {
    final user = Supabase.instance.client.auth.currentUser;
    final providerId = _savedIds[provider];

    if (user == null || providerId == null || providerId.isEmpty) return;

    try {
      await Supabase.instance.client
          .from('customer_favorites')
          .delete()
          .eq('customer_id', user.id)
          .eq('provider_id', providerId);

      if (!mounted) return;
      setState(() {
        _saved.remove(provider);
        _savedIds.remove(provider);
        _savedPhotos.remove(provider);
      });
    } catch (error) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Could not remove this saved provider.')),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return _CustomerPageShell(
      title: 'Saved Providers',
      child: SingleChildScrollView(
        padding: const EdgeInsets.all(18),
        child: Center(
          child: ConstrainedBox(
            constraints: const BoxConstraints(maxWidth: 1180),
