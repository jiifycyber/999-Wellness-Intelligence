  Future<void> _loadProviderConversation(Map<String, dynamic> customer) async {
    final user = Supabase.instance.client.auth.currentUser;
    final customerId = customer['id']?.toString() ?? '';

    if (user == null || customerId.isEmpty) {
      if (mounted) {
        setState(() {
          _providerChatLoading = false;
        });
      }

      return;
    }

    try {
      final sent = await Supabase.instance.client
          .from('messages')
          .select(
            'id, sender_id, receiver_id, message, read_at, created_at, '
            'attachment_path, attachment_name, attachment_type',
          )
          .eq('sender_id', user.id)
          .eq('receiver_id', customerId);

      final received = await Supabase.instance.client
          .from('messages')
          .select(
            'id, sender_id, receiver_id, message, read_at, created_at, '
            'attachment_path, attachment_name, attachment_type',
          )
          .eq('sender_id', customerId)
          .eq('receiver_id', user.id);

      final rows = <Map<String, dynamic>>[];

      for (final raw in sent as List) {
        rows.add(Map<String, dynamic>.from(raw as Map));
      }

      for (final raw in received as List) {
        rows.add(Map<String, dynamic>.from(raw as Map));
      }

      rows.sort((a, b) {
        final left = a['created_at']?.toString() ?? '';
        final right = b['created_at']?.toString() ?? '';
        return left.compareTo(right);
      });

      for (final row in rows) {
        final senderId = row['sender_id']?.toString() ?? '';
        final receiverId = row['receiver_id']?.toString() ?? '';
        final readAt = row['read_at'];

        if (senderId == customerId && receiverId == user.id && readAt == null) {
          final messageId = row['id']?.toString() ?? '';

          if (messageId.isNotEmpty) {
            try {
              await Supabase.instance.client
                  .from('messages')
                  .update({'read_at': DateTime.now().toUtc().toIso8601String()})
                  .eq('id', messageId);

              row['read_at'] = DateTime.now().toUtc().toIso8601String();
            } catch (_) {}
          }
        }
      }

      if (!mounted) {
        return;
      }

      setState(() {
        _providerActiveMessages = rows;
        _providerChatLoading = false;
      });

      await _loadProviderMessagingNetwork();
    } catch (_) {
      if (!mounted) {
        return;
      }

      setState(() {
        _providerChatLoading = false;
      });
    }
  }

  String _providerChatMimeType(String fileName) {
    final lower = fileName.toLowerCase();

    if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) {
      return 'image/jpeg';
    }
    if (lower.endsWith('.png')) return 'image/png';
    if (lower.endsWith('.webp')) return 'image/webp';
    if (lower.endsWith('.gif')) return 'image/gif';
    if (lower.endsWith('.heic')) return 'image/heic';
    if (lower.endsWith('.heif')) return 'image/heif';
    if (lower.endsWith('.mov')) return 'video/quicktime';
    if (lower.endsWith('.webm')) return 'video/webm';

    return 'video/mp4';
  }

  bool _providerChatIsVideo(dynamic type, dynamic path) {
    final mediaType = type?.toString().toLowerCase() ?? '';
    final mediaPath = path?.toString().toLowerCase() ?? '';

    return mediaType.startsWith('video/') ||
        mediaPath.endsWith('.mp4') ||
        mediaPath.endsWith('.mov') ||
        mediaPath.endsWith('.webm');
  }

  Future<String> _providerChatSignedUrl(dynamic pathValue) async {
    final storagePath = pathValue?.toString().trim() ?? '';

    if (storagePath.isEmpty) {
      return '';
    }

    try {
      return await Supabase.instance.client.storage
          .from('chat-media')
          .createSignedUrl(storagePath, 3600);
    } catch (_) {
      return '';
    }
  }

  Future<void> _pickAndSendProviderAttachment() async {
    final user = Supabase.instance.client.auth.currentUser;
    final customer = _providerSelectedCustomer;

    if (user == null || customer == null || _providerMessageSending) {
      return;
    }

    final customerId = customer['id']?.toString() ?? '';

    if (customerId.isEmpty) {
      return;
    }

    final picked = await FilePicker.pickFiles(
      type: FileType.custom,
      allowedExtensions: const [
        'jpg',
        'jpeg',
        'png',
        'webp',
        'gif',
        'heic',
        'heif',
        'mp4',
        'mov',
        'webm',
      ],
    );

    if (picked.isEmpty) {
      return;
    }

    final file = picked.first;
    final bytes = await file.readAsBytes();
    final mimeType = _providerChatMimeType(file.name);
    final isVideo = mimeType.startsWith('video/');

    final limit = isVideo ? 52428800 : 10485760;

    if (bytes.length > limit) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          behavior: SnackBarBehavior.floating,
          content: Text(
            isVideo
                ? 'Video must be 50 MB or smaller.'
                : 'Image must be 10 MB or smaller.',
          ),
        ),
      );
      return;
    }

    setState(() {
      _providerMessageSending = true;
    });

    try {
      final safeName = file.name.replaceAll(RegExp(r'[^A-Za-z0-9._-]'), '_');

      final stamp = DateTime.now().microsecondsSinceEpoch;

      final storagePath = '${user.id}/$customerId/${stamp}_$safeName';

      await Supabase.instance.client.storage
          .from('chat-media')
          .uploadBinary(
            storagePath,
            bytes,
            fileOptions: FileOptions(upsert: false, contentType: mimeType),
          );

      final caption = _providerMessageController.text.trim();

      await Supabase.instance.client.from('messages').insert({
        'sender_id': user.id,
        'receiver_id': customerId,
        'message': caption,
        'attachment_path': storagePath,
        'attachment_name': file.name,
        'attachment_type': mimeType,
      });

      _providerMessageController.clear();

      await _loadProviderConversation(customer);
      await _loadProviderMessagingNetwork();
    } catch (error) {
