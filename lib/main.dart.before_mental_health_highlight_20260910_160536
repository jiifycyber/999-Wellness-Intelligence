  String _providerAiSyncTime() {
    final sync = _providerAiLastSync;

    if (sync == null) {
      return _providerAiRefreshing
          ? 'Synchronizing provider intelligence'
          : 'Live provider systems ready';
    }

    final hour = sync.hour == 0
        ? 12
        : sync.hour > 12
        ? sync.hour - 12
        : sync.hour;

    final minute = sync.minute.toString().padLeft(2, '0');
    final suffix = sync.hour >= 12 ? 'PM' : 'AM';

    return 'Last synchronized at $hour:$minute $suffix';
  }

  List<double> _providerAiDailyRevenueSeries({int days = 7}) {
    final now = DateTime.now();
    final today = DateTime(now.year, now.month, now.day);

    final totals = List<double>.filled(days, 0);

    for (final booking in _paidProviderBookings) {
      final date = _providerAiBookingDate(booking);

      if (date == null) {
        continue;
      }

      final bookingDay = DateTime(date.year, date.month, date.day);
      final difference = today.difference(bookingDay).inDays;

      if (difference < 0 || difference >= days) {
        continue;
      }

      final index = days - 1 - difference;
      totals[index] += _providerAiBookingRevenue(booking);
    }

    return totals;
  }

