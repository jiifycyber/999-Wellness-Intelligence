class _CustomerHomeV4CommunityPreviewState
    extends State<_CustomerHomeV4CommunityPreview> {
  bool _loading = true;
  List<Map<String, dynamic>> _posts = [];
  final Map<String, String> _mediaUrls = {};

  @override
  void initState() {
    super.initState();
    _load();
  }

  Future<void> _load() async {
    try {
      final rows = await Supabase.instance.client
          .from("community_posts")
          .select(
            "id, author_name, author_role, author_photo_url, "
            "body, media_path, media_type, created_at",
          )
          .order("created_at", ascending: false)
          .limit(2);

      final posts = (rows as List)
          .map((row) => Map<String, dynamic>.from(row as Map))
          .toList();

      final urls = <String, String>{};

      for (final post in posts) {
        final id = (post["id"] ?? "").toString();
        final path = (post["media_path"] ?? "").toString().trim();

        if (id.isEmpty || path.isEmpty) continue;

        try {
          final url = await Supabase.instance.client.storage
              .from("feed-media")
              .createSignedUrl(path, 3600);

          urls[id] = url;
        } catch (_) {}
      }

      if (!mounted) return;

      setState(() {
        _posts = posts;
        _mediaUrls
          ..clear()
          ..addAll(urls);
        _loading = false;
      });
    } catch (_) {
      if (!mounted) return;

      setState(() {
        _posts = [];
        _loading = false;
      });
    }
  }

  String _time(dynamic value) {
    if (value == null) return "Recently";

    final date = DateTime.tryParse(value.toString());

    if (date == null) return "Recently";

    final diff = DateTime.now().difference(date);

    if (diff.inMinutes < 1) return "Just now";
    if (diff.inMinutes < 60) return "${diff.inMinutes}m ago";
    if (diff.inHours < 24) return "${diff.inHours}h ago";

    return "${diff.inDays}d ago";
  }

  Widget _mediaPanel(String id, int index) {
    final url = _mediaUrls[id];

    if (url != null && url.isNotEmpty) {
      return ClipRRect(
        borderRadius: BorderRadius.circular(14),
        child: Image.network(
          url,
          fit: BoxFit.cover,
          errorBuilder: (_, __, ___) => _fallbackMedia(index),
        ),
      );
    }

    return _fallbackMedia(index);
  }

  Widget _fallbackMedia(int index) {
    return Container(
      decoration: BoxDecoration(
        borderRadius: BorderRadius.circular(14),
        gradient: LinearGradient(
          begin: Alignment.topLeft,
