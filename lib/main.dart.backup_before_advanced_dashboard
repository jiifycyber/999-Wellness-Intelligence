class _BackgroundLayer extends StatelessWidget {
  const _BackgroundLayer();

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final mobile = constraints.maxWidth < 700;

        if (!mobile) {
          return Stack(
            fit: StackFit.expand,
            children: [
              Container(color: const Color(0xFF08050C)),
              Image.asset(
                'assets/login_background.png',
                fit: BoxFit.cover,
                alignment: Alignment.center,
                filterQuality: FilterQuality.high,
              ),
              Container(
                decoration: BoxDecoration(
                  gradient: LinearGradient(
                    begin: Alignment.topCenter,
                    end: Alignment.bottomCenter,
                    colors: [
                      Colors.black.withValues(alpha: 0.05),
                      const Color(0xFF100817).withValues(alpha: 0.10),
                      Colors.black.withValues(alpha: 0.24),
                    ],
                  ),
                ),
              ),
            ],
          );
        }

        // MOBILE:
        // Keep the entire width of the original landscape image visible.
        // This preserves BOTH massage scenes instead of cropping them away.
        return Stack(
          fit: StackFit.expand,
          children: [
            Container(color: const Color(0xFF08050C)),

            Align(
              alignment: Alignment.topCenter,
              child: SizedBox(
                width: constraints.maxWidth,
                child: Image.asset(
                  'assets/login_background.png',
                  width: constraints.maxWidth,
                  fit: BoxFit.fitWidth,
                  alignment: Alignment.topCenter,
                  filterQuality: FilterQuality.high,
                ),
              ),
            ),

            // Darken the very top slightly so branding remains readable.
            Positioned(
              top: 0,
              left: 0,
              right: 0,
              height: 110,
              child: Container(
                decoration: BoxDecoration(
                  gradient: LinearGradient(
                    begin: Alignment.topCenter,
                    end: Alignment.bottomCenter,
                    colors: [
                      Colors.black.withValues(alpha: 0.38),
                      Colors.transparent,
                    ],
                  ),
                ),
              ),
            ),

            // Smoothly fade the photo into the login area.
            Positioned(
              top: 215,
              left: 0,
              right: 0,
              height: 275,
              child: IgnorePointer(
                child: Container(
                  decoration: BoxDecoration(
                    gradient: LinearGradient(
                      begin: Alignment.topCenter,
                      end: Alignment.bottomCenter,
                      colors: [
                        Colors.transparent,
                        const Color(0xFF09060F).withValues(alpha: 0.56),
                        const Color(0xFF09060F).withValues(alpha: 0.94),
                        const Color(0xFF09060F),
                      ],
                    ),
                  ),
                ),
              ),
            ),

            // Continue the same dark background down the page.
            Positioned(
              top: 470,
              left: 0,
              right: 0,
              bottom: 0,
              child: Container(color: const Color(0xFF09060F)),
            ),
          ],
        );
      },
    );
  }
}

