    Navigator.of(context)
        .push(
          MaterialPageRoute(
            builder: (_) => CommunityMemberProfileScreen(
              userId: userId,
              fallbackName: name,
              fallbackRole: role,
              fallbackPhoto: photo,
            ),
          ),
        )
        .then((_) {
          _loadFeed();
        });
  }

