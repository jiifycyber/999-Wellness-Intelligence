class _CustomerBookingsScreenState extends State<_CustomerBookingsScreen> {
  int _tab = 0;
  late Future<List<Map<String, dynamic>>> _bookingsFuture;

  @override
  void initState() {
    super.initState();
    _bookingsFuture = _loadBookings();
  }

  Future<List<Map<String, dynamic>>> _loadBookings() async {
    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) {
      return [];
    }

    final data = await Supabase.instance.client
        .from('bookings')
        .select(
          'id, customer_id, provider_id, provider_name, service_name, '
          'booking_day, booking_time, service_type, service_address, '
          'status, payment_status, eta_minutes, created_at, updated_at',
        )
        .eq('customer_id', user.id)
        .order('created_at', ascending: false);

    return List<Map<String, dynamic>>.from(data);
  }

  Future<void> _refreshBookings() async {
    setState(() {
      _bookingsFuture = _loadBookings();
    });

    await _bookingsFuture;
  }

  bool _isPast(Map<String, dynamic> booking) {
    final status = booking['status']?.toString() ?? '';

    return status == 'Completed' || status == 'Cancelled';
  }

  @override
  Widget build(BuildContext context) {
    return _CustomerPageShell(
      title: 'My Bookings',
      child: RefreshIndicator(
        onRefresh: _refreshBookings,
        child: SingleChildScrollView(
          physics: const AlwaysScrollableScrollPhysics(),
          padding: const EdgeInsets.all(18),
          child: Center(
            child: ConstrainedBox(
              constraints: const BoxConstraints(maxWidth: 1180),
              child: FutureBuilder<List<Map<String, dynamic>>>(
                future: _bookingsFuture,
                builder: (context, snapshot) {
                  if (snapshot.connectionState == ConnectionState.waiting) {
                    return const _V4CommandPanel(
                      child: Padding(
                        padding: EdgeInsets.all(55),
                        child: Center(child: CircularProgressIndicator()),
                      ),
                    );
                  }

                  if (snapshot.hasError) {
                    return _V4CommandPanel(
                      accent: const Color(0xFFFF738D),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.stretch,
                        children: [
                          const _V4CommandHeader(
                            icon: Icons.warning_amber_rounded,
                            title: 'BOOKING NETWORK ERROR',
                            subtitle: 'SECURE DATA CONNECTION',
                            status: 'ATTENTION',
                            statusColor: Color(0xFFFF738D),
                          ),
                          const SizedBox(height: 15),
                          const Text(
                            'Your bookings could not be loaded from the server.',
                            style: TextStyle(color: Colors.white70),
                          ),
                          const SizedBox(height: 14),
                          Align(
                            alignment: Alignment.centerLeft,
                            child: FilledButton.icon(
                              onPressed: _refreshBookings,
                              icon: const Icon(Icons.refresh_rounded),
                              label: const Text('Retry Connection'),
                            ),
                          ),
                        ],
                      ),
                    );
                  }

                  final allBookings = snapshot.data ?? [];

                  final upcoming = allBookings.where((b) => !_isPast(b)).length;

                  final past = allBookings.where((b) => _isPast(b)).length;

                  final visibleBookings = allBookings.where((booking) {
                    final isPast = _isPast(booking);

                    return _tab == 0 ? !isPast : isPast;
