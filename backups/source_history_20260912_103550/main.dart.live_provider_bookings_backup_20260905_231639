  Widget _buildDashboard(bool desktop) {
    return SingleChildScrollView(
      padding: EdgeInsets.fromLTRB(
        desktop ? 28 : 14,
        16,
        desktop ? 28 : 14,
        desktop ? 45 : 110,
      ),
      child: Center(
        child: ConstrainedBox(
          constraints: const BoxConstraints(maxWidth: 1450),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              _providerHero(desktop),

              const SizedBox(height: 22),

              const _V2SectionLabel(
                title: 'PROVIDER PULSE',
                subtitle: 'LIVE OPERATING INTELLIGENCE',
                icon: Icons.monitor_heart_outlined,
              ),

              const SizedBox(height: 11),

              LayoutBuilder(
                builder: (context, box) {
                  final columns = box.maxWidth >= 1100
                      ? 4
                      : box.maxWidth >= 650
                      ? 2
                      : 1;

                  const spacing = 12.0;

                  final width =
                      (box.maxWidth - spacing * (columns - 1)) / columns;

                  return Wrap(
                    spacing: spacing,
