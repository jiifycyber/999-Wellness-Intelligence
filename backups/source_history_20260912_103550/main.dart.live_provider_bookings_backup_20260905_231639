class _V2BackgroundPainter extends CustomPainter {
  const _V2BackgroundPainter();

  @override
  void paint(Canvas canvas, Size size) {
    final fine = Paint()
      ..color = const Color(0xFF445FA5).withValues(alpha: .035)
      ..strokeWidth = .7;

    const grid = 54.0;

    for (double x = 0; x < size.width; x += grid) {
      canvas.drawLine(Offset(x, 0), Offset(x, size.height), fine);
    }

    for (double y = 0; y < size.height; y += grid) {
      canvas.drawLine(Offset(0, y), Offset(size.width, y), fine);
    }

    final scan = Paint()
      ..color = const Color(0xFF5F4FFF).withValues(alpha: .035)
      ..strokeWidth = 1;

    for (double y = 22; y < size.height; y += 130) {
      canvas.drawLine(Offset(0, y), Offset(size.width, y), scan);
    }
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

class _V2HeroGridPainter extends CustomPainter {
  const _V2HeroGridPainter();

  @override
  void paint(Canvas canvas, Size size) {
    final p = Paint()
      ..color = const Color(0xFF627BFF).withValues(alpha: .045)
      ..strokeWidth = .8;

    for (double x = 0; x < size.width; x += 46) {
      canvas.drawLine(Offset(x, 0), Offset(x, size.height), p);
    }

    for (double y = 0; y < size.height; y += 46) {
      canvas.drawLine(Offset(0, y), Offset(size.width, y), p);
    }

    final beam = Paint()
      ..shader = const LinearGradient(
        colors: [Colors.transparent, Color(0x336F6CFF), Colors.transparent],
      ).createShader(Rect.fromLTWH(0, size.height * .66, size.width, 1));

    canvas.drawRect(Rect.fromLTWH(0, size.height * .66, size.width, 1), beam);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

class _V2GlobePainter extends CustomPainter {
  const _V2GlobePainter();

  @override
  void paint(Canvas canvas, Size size) {
    final center = Offset(size.width * .58, size.height * .46);
    final radius = size.shortestSide * .42;

    final globePaint = Paint()
      ..shader = RadialGradient(
        colors: [
          const Color(0xFF273E8A).withValues(alpha: .20),
          const Color(0xFF10204B).withValues(alpha: .30),
          const Color(0xFF060A14).withValues(alpha: .10),
        ],
      ).createShader(Rect.fromCircle(center: center, radius: radius));

    canvas.drawCircle(center, radius, globePaint);

    final edge = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1.2
      ..color = const Color(0xFF6579FF).withValues(alpha: .37);

    canvas.drawCircle(center, radius, edge);

    final latitude = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = .65
      ..color = const Color(0xFF556DD8).withValues(alpha: .20);

    for (final scale in [.3, .58, .82]) {
      canvas.drawOval(
        Rect.fromCenter(
          center: center,
          width: radius * 2,
          height: radius * 2 * scale,
        ),
        latitude,
      );
    }

    for (final scale in [.33, .68]) {
      canvas.drawOval(
        Rect.fromCenter(
          center: center,
          width: radius * 2 * scale,
          height: radius * 2,
        ),
        latitude,
      );
    }

    final route = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1
      ..color = const Color(0xFF8A67FF).withValues(alpha: .58);

    final nodes = [
      Offset(center.dx - radius * .66, center.dy - radius * .18),
      Offset(center.dx - radius * .24, center.dy + radius * .38),
      Offset(center.dx + radius * .24, center.dy - radius * .30),
      Offset(center.dx + radius * .64, center.dy + radius * .08),
    ];

    canvas.drawLine(nodes[0], nodes[2], route);
    canvas.drawLine(nodes[2], nodes[3], route);
    canvas.drawLine(nodes[1], nodes[3], route);

    for (final node in nodes) {
      canvas.drawCircle(node, 3.5, Paint()..color = const Color(0xFF9C80FF));

      canvas.drawCircle(
        node,
        8,
        Paint()
          ..style = PaintingStyle.stroke
          ..strokeWidth = .8
          ..color = const Color(0xFF9C80FF).withValues(alpha: .22),
      );
    }
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

class _V2AiOrbPainter extends CustomPainter {
  const _V2AiOrbPainter();

  @override
  void paint(Canvas canvas, Size size) {
    final center = Offset(size.width / 2, size.height / 2);

    final glow = Paint()
      ..shader = const RadialGradient(
        colors: [Color(0x668A4FFF), Color(0x22663DFF), Colors.transparent],
      ).createShader(Rect.fromCircle(center: center, radius: 57));

    canvas.drawCircle(center, 57, glow);

    final paints = [
      Paint()
        ..style = PaintingStyle.stroke
        ..strokeWidth = 2
        ..color = const Color(0xFF7D5BFF).withValues(alpha: .72),
      Paint()
        ..style = PaintingStyle.stroke
        ..strokeWidth = 1.5
        ..color = const Color(0xFF45D4FF).withValues(alpha: .48),
      Paint()
        ..style = PaintingStyle.stroke
        ..strokeWidth = 1.5
        ..color = const Color(0xFFCA57FF).withValues(alpha: .48),
    ];

    canvas.save();
    canvas.translate(center.dx, center.dy);

    canvas.rotate(.28);
    canvas.drawOval(
      Rect.fromCenter(center: Offset.zero, width: 112, height: 46),
      paints[0],
    );

    canvas.rotate(1.02);
    canvas.drawOval(
      Rect.fromCenter(center: Offset.zero, width: 105, height: 39),
      paints[1],
    );

    canvas.rotate(.92);
    canvas.drawOval(
      Rect.fromCenter(center: Offset.zero, width: 99, height: 34),
      paints[2],
    );

    canvas.restore();

    canvas.drawCircle(center, 28, Paint()..color = const Color(0xFF161446));

    canvas.drawCircle(
      center,
      28,
      Paint()
        ..style = PaintingStyle.stroke
        ..strokeWidth = 1
        ..color = const Color(0xFF8D80FF).withValues(alpha: .7),
    );
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

