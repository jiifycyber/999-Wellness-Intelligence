class _CustomerBookingFlowScreen extends StatefulWidget {
  const _CustomerBookingFlowScreen({required this.providerName});

  final String providerName;

  @override
  State<_CustomerBookingFlowScreen> createState() =>
      _CustomerBookingFlowScreenState();
}

class _CustomerBookingFlowScreenState
    extends State<_CustomerBookingFlowScreen> {
  String _service = 'Deep Tissue';
  String _day = 'Today';
  String _time = '4:30 PM';
  bool _submitting = false;

  Future<void> _submitBooking() async {
    if (_submitting) return;

    final user = Supabase.instance.client.auth.currentUser;

    if (user == null) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Please sign in before creating a booking.'),
        ),
      );
      return;
    }

    setState(() {
      _submitting = true;
    });

    try {
      final providerRecord = await Supabase.instance.client
          .from('provider_profiles')
          .select('id')
          .eq('professional_name', widget.providerName)
          .maybeSingle();

      final providerId = providerRecord?['id']?.toString();

      await Supabase.instance.client.from('bookings').insert({
        'customer_id': user.id,
        'provider_id': providerId,
        'provider_name': widget.providerName,
        'service_name': _service,
        'booking_day': _day,
        'booking_time': _time,
        'service_type': 'Mobile Service',
        'status': 'Requested',
        'payment_status': 'Pending',
      });

      if (!mounted) return;

      await showDialog<void>(
        context: context,
        builder: (dialogContext) {
          return AlertDialog(
            backgroundColor: const Color(0xFF18101F),
            title: const Text(
              'Booking Requested',
              style: TextStyle(color: Colors.white),
            ),
            content: Text(
              'Your $_service appointment with ${widget.providerName} '
              'has been requested for $_day at $_time.',
              style: const TextStyle(color: Colors.white70),
            ),
            actions: [
              FilledButton(
                onPressed: () => Navigator.of(dialogContext).pop(),
                child: const Text('View Booking'),
              ),
            ],
          );
        },
      );

      if (!mounted) return;

      Navigator.of(context).pushReplacement(
        MaterialPageRoute(builder: (_) => const _CustomerBookingsScreen()),
      );
    } catch (error) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Unable to create booking: $error')),
      );
    } finally {
      if (mounted) {
        setState(() {
          _submitting = false;
        });
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    return _CustomerPageShell(
      title: 'Book ${widget.providerName}',
      child: SingleChildScrollView(
        padding: const EdgeInsets.all(18),
        child: Center(
          child: ConstrainedBox(
            constraints: const BoxConstraints(maxWidth: 760),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                const _BookingSectionTitle(
                  number: '01',
                  title: 'Choose Service',
                ),
                const SizedBox(height: 10),
                Wrap(
                  spacing: 8,
                  runSpacing: 8,
                  children: [
                    for (final option in const [
                      'Deep Tissue',
                      'Relaxation Massage',
                      'Sports Massage',
                      'Facial',
                    ])
                      ChoiceChip(
                        label: Text(option),
                        selected: _service == option,
                        onSelected: (_) {
                          setState(() {
                            _service = option;
                          });
                        },
                      ),
                  ],
                ),

                const SizedBox(height: 25),

                const _BookingSectionTitle(number: '02', title: 'Choose Day'),
                const SizedBox(height: 10),

                Wrap(
                  spacing: 8,
                  children: [
                    for (final option in const [
                      'Today',
                      'Tomorrow',
                      'Saturday',
                    ])
                      ChoiceChip(
                        label: Text(option),
                        selected: _day == option,
                        onSelected: (_) {
                          setState(() {
                            _day = option;
                          });
                        },
                      ),
                  ],
                ),

                const SizedBox(height: 25),

                const _BookingSectionTitle(number: '03', title: 'Choose Time'),
                const SizedBox(height: 10),

                Wrap(
                  spacing: 8,
                  runSpacing: 8,
                  children: [
                    for (final option in const [
                      '11:00 AM',
                      '2:00 PM',
                      '4:30 PM',
                      '6:00 PM',
                    ])
                      ChoiceChip(
                        label: Text(option),
                        selected: _time == option,
                        onSelected: (_) {
                          setState(() {
                            _time = option;
                          });
                        },
                      ),
                  ],
                ),

                const SizedBox(height: 26),

                Container(
                  padding: const EdgeInsets.all(20),
                  decoration: BoxDecoration(
                    color: const Color(0xFF18111F),
                    borderRadius: BorderRadius.circular(22),
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const Text(
                        'BOOKING SUMMARY',
                        style: TextStyle(
                          color: Colors.white,
                          fontWeight: FontWeight.w900,
                        ),
                      ),
                      const SizedBox(height: 13),
                      _BookingSummaryRow(
                        label: 'Provider',
                        value: widget.providerName,
                      ),
                      _BookingSummaryRow(label: 'Service', value: _service),
