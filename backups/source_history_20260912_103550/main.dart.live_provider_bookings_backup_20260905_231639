      case 'Bookings':
        return _bookings();

      case 'Schedule & Availability':
        return _schedule();

      case 'Provider Profile':
        return _profile();

      case 'Photos & Videos':
        return _media();

      case 'Earnings':
        return _earnings();

      case 'Agent Duke AI':
        return _ai();

