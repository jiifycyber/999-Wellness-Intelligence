class _CustomerV3ContentPainter extends CustomPainter {
  const _CustomerV3ContentPainter();

  @override
  void paint(Canvas canvas, Size size) {
    final grid = Paint()
      ..color = const Color(0xFF5470B8).withValues(alpha: .028)
      ..strokeWidth = .7;

    const spacing = 44.0;

    for (double x = 0; x < size.width; x += spacing) {
      canvas.drawLine(Offset(x, 0), Offset(x, size.height), grid);
    }

    for (double y = 0; y < size.height; y += spacing) {
      canvas.drawLine(Offset(0, y), Offset(size.width, y), grid);
    }

    final accent = Paint()
      ..color = const Color(0xFF5E49FF).withValues(alpha: .035)
      ..strokeWidth = 1;

    canvas.drawLine(
      Offset(0, size.height * .23),
      Offset(size.width, size.height * .23),
      accent,
    );
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

class _CustomerPageShell extends StatelessWidget {
  const _CustomerPageShell({
    required this.title,
    required this.child,
    this.actions,
  });

  final String title;
  final Widget child;
  final List<Widget>? actions;

  bool get _searchPage {
    final t = title.toLowerCase();
    return t.contains('provider') || t.contains('search');
  }

  bool get _bookingPage => title.toLowerCase().contains('booking');

  bool get _favoritePage {
    final t = title.toLowerCase();
    return t.contains('saved') || t.contains('favorite');
  }

  bool get _profilePage {
    final t = title.toLowerCase();
    return t.contains('account') || t.contains('profile');
  }

  bool get _messagePage => title.toLowerCase().contains('message');

  bool get _settingsPage => title.toLowerCase().contains('setting');

  String get _commandTitle {
    if (_searchPage) return 'Provider Discovery';
    if (_bookingPage) return 'Booking Command Center';
    if (_favoritePage) return 'Saved Provider Network';
    if (_profilePage) return 'Customer Intelligence Profile';
    if (_messagePage) return 'Secure Communications';
    if (_settingsPage) return 'Customer Control Center';
    return title;
  }

  String get _commandSubtitle {
    if (_searchPage) {
      return 'Discover wellness professionals through the 999 Intelligence Network.';
    }

    if (_bookingPage) {
      return 'Track appointments, live status, provider activity and wellness operations.';
    }

    if (_favoritePage) {
      return 'Your private network of preferred wellness professionals.';
    }

    if (_profilePage) {
      return 'Identity, preferences, security and customer account intelligence.';
