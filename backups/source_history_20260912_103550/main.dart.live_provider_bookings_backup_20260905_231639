      final q = _query.trim().toLowerCase();

      final services = (provider['services'] as List<dynamic>)
          .join(' ')
          .toLowerCase();

      final matchesText =
          q.isEmpty ||
          provider['name'].toString().toLowerCase().contains(q) ||
          provider['title'].toString().toLowerCase().contains(q) ||
          services.contains(q);

      final matchesCategory =
          _category == 'All' || provider['category'] == _category;

      return matchesText && matchesCategory;
    }).toList();
  }

