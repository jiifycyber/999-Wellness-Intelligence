class _ActiveCustomerBookingCard extends StatelessWidget {
  const _ActiveCustomerBookingCard({
    required this.booking,
    required this.onChanged,
  });

  final Map<String, dynamic> booking;
  final Future<void> Function() onChanged;

  static const _statuses = [
    'Requested',
    'Accepted',
    'En Route',
    'Arrived',
    'In Session',
    'Completed',
  ];

  String get _status => booking['status']?.toString() ?? 'Requested';

  String get _provider =>
      booking['provider_name']?.toString() ?? 'Wellness Provider';

  String get _service =>
      booking['service_name']?.toString() ?? 'Wellness Service';

  String get _day => booking['booking_day']?.toString() ?? '';

  String get _time => booking['booking_time']?.toString() ?? '';

  String get _serviceType =>
      booking['service_type']?.toString() ?? 'Mobile Service';

  String get _payment => booking['payment_status']?.toString() ?? 'Pending';

  String get _address {
    final value = booking['service_address']?.toString();

    if (value == null || value.trim().isEmpty) {
      return 'Customer service address';
    }

    return value;
  }

  int get _statusIndex {
    final index = _statuses.indexOf(_status);
    return index < 0 ? 0 : index;
  }

  IconData _statusIcon(String status) {
    switch (status) {
      case 'Requested':
        return Icons.hourglass_top_rounded;
      case 'Accepted':
        return Icons.check_circle_rounded;
      case 'En Route':
        return Icons.directions_car_filled_rounded;
      case 'Arrived':
        return Icons.location_on_rounded;
      case 'In Session':
        return Icons.spa_rounded;
      case 'Completed':
        return Icons.verified_rounded;
      default:
        return Icons.circle;
    }
  }

  String _travelStatus() {
    switch (_status) {
      case 'Requested':
        return 'Waiting for provider response';
      case 'Accepted':
        return 'Provider accepted your appointment';
      case 'En Route':
        return 'Provider is traveling to you';
      case 'Arrived':
        return 'Provider has arrived';
      case 'In Session':
        return 'Wellness session in progress';
      case 'Completed':
        return 'Appointment completed';
      case 'Cancelled':
        return 'Appointment cancelled';
      default:
        return _status;
    }
  }

  String _etaText() {
    if (_status != 'En Route') {
      return 'Available when provider is en route';
    }

    final eta = booking['eta_minutes'];

    if (eta == null) {
      return 'Provider is en route';
    }

    return '$eta minutes';
  }

  Future<void> _cancelBooking(BuildContext context) async {
    final id = booking['id']?.toString();

    if (id == null || id.isEmpty) {
      return;
    }

    final confirmed = await showDialog<bool>(
      context: context,
      builder: (dialogContext) {
        return AlertDialog(
          backgroundColor: const Color(0xFF18101F),
          title: const Text(
            'Cancel Appointment?',
            style: TextStyle(color: Colors.white),
          ),
          content: const Text(
            'Are you sure you want to cancel this appointment?',
            style: TextStyle(color: Colors.white70),
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.of(dialogContext).pop(false),
              child: const Text('Keep Appointment'),
            ),
            FilledButton(
              onPressed: () => Navigator.of(dialogContext).pop(true),
              child: const Text('Cancel Booking'),
            ),
          ],
        );
      },
    );

    if (confirmed != true) {
      return;
    }

    try {
      await Supabase.instance.client
          .from('bookings')
          .update({'status': 'Cancelled'})
          .eq('id', id);

      await onChanged();

      if (!context.mounted) {
        return;
      }

      ScaffoldMessenger.of(
        context,
      ).showSnackBar(const SnackBar(content: Text('Appointment cancelled.')));
    } catch (error) {
      if (!context.mounted) {
        return;
      }

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Unable to cancel booking: $error')),
      );
    }
  }

  Widget _buildStatusTimeline() {
    if (_status == 'Cancelled') {
      return Container(
        padding: const EdgeInsets.all(18),
        decoration: BoxDecoration(
          color: const Color(0xFF25151C),
          borderRadius: BorderRadius.circular(18),
        ),
        child: const Row(
          children: [
            Icon(Icons.cancel_rounded, color: Color(0xFFFF8C9A)),
            SizedBox(width: 12),
            Expanded(
              child: Text(
                'This appointment was cancelled.',
                style: TextStyle(
                  color: Colors.white,
                  fontWeight: FontWeight.w800,
                ),
              ),
            ),
          ],
        ),
      );
    }

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        const Text(
          'APPOINTMENT STATUS',
          style: TextStyle(
            color: Colors.white54,
            fontSize: 12,
            fontWeight: FontWeight.w900,
            letterSpacing: 1,
          ),
        ),
        const SizedBox(height: 15),

        ...List.generate(_statuses.length, (index) {
          final active = index <= _statusIndex;
          final current = index == _statusIndex;

          return Row(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Column(
                children: [
                  Container(
                    width: 36,
                    height: 36,
                    decoration: BoxDecoration(
                      shape: BoxShape.circle,
                      color: active
                          ? const Color(0xFF783ED0)
                          : const Color(0xFF28202E),
                    ),
                    child: Icon(
                      _statusIcon(_statuses[index]),
                      color: active ? Colors.white : Colors.white30,
                      size: 18,
                    ),
                  ),
                  if (index != _statuses.length - 1)
                    Container(
                      width: 2,
