    _selected = widget.currentValue;
  }

  @override
  void dispose() {
    _searchController.dispose();
    super.dispose();
  }

  List<String> get _visibleValues {
    if (_query.trim().isEmpty) {
      return widget.values;
    }

    final q = _query.toLowerCase();

    return widget.values
        .where((item) => item.toLowerCase().contains(q))
        .toList();
  }

  String get _subtitle {
    switch (widget.title) {
      case 'City':
        return 'Choose where you want to discover wellness providers.';
      case 'State':
        return 'Browse provider availability across the United States.';
      case 'Specialty':
        return 'Explore massage, facial, skincare, bodywork and wellness services.';
      case 'Gender':
        return 'Choose your provider preference.';
      case 'Mobile / Studio':
        return 'Choose where you prefer your wellness service.';
